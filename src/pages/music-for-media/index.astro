---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title={"Music for Film, Video and Media — Auspicious Music"}
  description={"Composing, licensing and delivering music for film, video, events and ceremonies."}
  canonicalPath={"/music-for-media/"}
  lang={"en"}
  noindex={false}
  loadStringField={false}
>
<Fragment slot="head">
<style is:global>
@layer components {
  .hub-head { padding-block: clamp(2rem, 4vw, 3rem) clamp(2.5rem, 5vw, 4rem); }
  .hub-head h1 { max-width: 17ch; margin-top: 1.25rem; }
  .hub-head .lede { margin-top: 1.5rem; max-width: 58ch; }

  /* ---- hub signature ----
     Each hub opens on a diagram of its own discipline, so the five main
     sections stop reading as one template with different words. Line work
     only, one ember mark per figure, and hidden below 820px where the head
     needs its full width for type. */
  .hub-head__inner { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
  @media (min-width: 820px) {
    .hub-head__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr); }
  }
  .sig { display: none; }
  @media (min-width: 820px) {
    .sig { display: grid; gap: 0.875rem; justify-items: end; }
    .sig svg { inline-size: 100%; max-inline-size: 320px; height: auto; }
    .sig rect, .sig circle { fill: var(--line-strong); }
    .sig path, .sig line { stroke: var(--line-strong); stroke-width: 1.25; }
    .sig .sig-empty { fill: none; stroke: var(--line); stroke-width: 1; }
    .sig .sig-solid { fill: var(--ink-soft); }
    .sig .sig-mark { fill: var(--ember-bright); }
    circle.sig-mark { fill: none; stroke: var(--ember-bright); stroke-width: 2; }
    .sig .sig-play { stroke: var(--ember-bright); stroke-width: 1.25; }
    .sig figcaption {
      font-family: var(--font-mono); font-size: var(--t-meta);
      letter-spacing: var(--tr-meta); color: var(--muted);
    }
  }

  .topics { border-top: 1px solid var(--line); }
  .topics li { border-bottom: 1px solid var(--line); }
  .topics a {
    display: grid; gap: 0.375rem 2.5rem; padding-block: 1.5rem;
    text-decoration: none; align-items: baseline;
    transition: background-color var(--dur-fast) var(--ease);
  }
  .topics a:hover { background: var(--surface); }
  .topics h3 { font-size: clamp(1.25rem, 1.05rem + 0.75vw, 1.625rem); letter-spacing: -0.015em; }
  .topics p { color: var(--muted); font-size: 1rem; line-height: 1.6; max-width: 58ch; }
  @media (min-width: 900px) {
    .topics a { grid-template-columns: minmax(0, 14rem) minmax(0, 1fr); align-items: start; }
  }

  .feature__inner { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
  @media (min-width: 940px) { .feature__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); } }
  .feature h2 { font-size: clamp(1.75rem, 1.15rem + 2.1vw, 2.75rem); max-width: 20ch; margin-top: 0.875rem; }
  .feature p { color: var(--dark-muted); margin-top: 1.125rem; max-width: 46ch; font-size: 1.0625rem; line-height: 1.65; }
  .feature .meta { margin-top: 1.5rem; }
  .feature .link { margin-top: 1.75rem; }
  .feature .ph { aspect-ratio: 4 / 3; }

  .tail { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 900px) { .tail { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 4.5rem; } }
  .glossary > div { padding-block: 1.125rem; border-top: 1px solid var(--line); }
  .glossary > div:last-child { border-bottom: 1px solid var(--line); }
  .glossary dt { font-weight: 550; font-size: 1.0625rem; letter-spacing: -0.01em; }
  .glossary dd { color: var(--muted); font-size: 1rem; line-height: 1.6; margin-top: 0.25rem; max-width: 54ch; }
  .related li { border-top: 1px solid var(--line); }
  .related li:last-child { border-bottom: 1px solid var(--line); }
  .related a {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem;
    padding-block: 1.125rem; text-decoration: none; font-size: 1.0625rem; font-weight: 500;
  }
  .related a:hover { color: var(--accent); }
  .related svg { width: 14px; height: 14px; flex: none; }
}
</style>
</Fragment>

<main id="content">

  <section class="hub-head" data-od-id="hub-head">
    <div class="shell">
      <div class="hub-head__inner">
        <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li>Music for Media</li>
          </ol>
        </nav>
        <h1>Music for film, video and media</h1>
        <p class="lede">Music that exists to serve something else — a picture, an event, a room full of people. Composition and arrangement under a brief, the licensing terms that decide who may use what, and delivery specifications that change depending on where the track ends up.</p>
      </div>
        <figure class="sig" aria-hidden="true">
          <svg viewBox="0 0 200 104" fill="none" role="presentation"><rect x="0" y="0" width="25" height="20" rx="2" class="sig-empty"/><rect x="28" y="0" width="25" height="20" rx="2" class="sig-empty"/><rect x="56" y="0" width="25" height="20" rx="2" class="sig-empty"/><rect x="84" y="0" width="25" height="20" rx="2" class="sig-empty"/><rect x="112" y="0" width="25" height="20" rx="2" class="sig-empty"/><rect x="140" y="0" width="25" height="20" rx="2" class="sig-empty"/><rect x="168" y="0" width="25" height="20" rx="2" class="sig-empty"/><rect x="0" y="34" width="84" height="12" rx="2"/><rect x="96" y="56" width="62" height="12" rx="2" class="sig-mark"/><rect x="172" y="78" width="24" height="12" rx="2"/><line x1="118" y1="-4" x2="118" y2="104" class="sig-play"/></svg>
          <figcaption>Timeline</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section data-od-id="hub-topics" aria-labelledby="topics-title">
    <div class="shell">
      <h2 id="topics-title" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)">Topics in this hub</h2>
      <ul class="topics" data-reveal-group>
        <li data-reveal><a href="/publishing-roadmap/">
          <h3>Licensing</h3>
          <p>What the terms mean, who holds which right, and the questions to settle before a track is delivered.</p>
        </a></li>
        <li data-reveal><a href="/publishing-roadmap/">
          <h3>Film and video</h3>
          <p>Scoring to picture, loudness for online delivery, and the alternate versions an editor will ask for.</p>
        </a></li>
        <li data-reveal><a href="/publishing-roadmap/">
          <h3>Events and ceremonies</h3>
          <p>Music for weddings, ceremonies and occasions, where the arrangement has to survive a real room.</p>
        </a></li>
        <li data-reveal><a href="/publishing-roadmap/">
          <h3>Delivery</h3>
          <p>File formats, stems, metadata and the checklist that prevents a redelivery.</p>
        </a></li>
      </ul>
    </div>
  </section>

  <section class="band band-dark feature" data-od-id="hub-feature" aria-labelledby="feature-title">
    <div class="shell feature__inner">
      <div class="ph" data-reveal>
        <span class="ph__label"><strong>Screenshot</strong> — delivery folder with stems and alternates<br>to be captured at 2400 × 1500</span>
      </div>
      <div data-reveal data-reveal-delay="120">
        <p class="kicker">Start here</p>
        <h2 id="feature-title">Production Music Licensing: A Practical Introduction</h2>
        <p>Exclusive, non-exclusive, sync, master, mechanical — the vocabulary sorted out once, with the questions worth asking before signing anything. Sourced from primary documentation, with no claim to be legal advice.</p>
        <p class="meta"><span>Guide</span><span>18 min</span><span>Reviewed Jul 2026</span></p>
        <a class="link" href="/publishing-roadmap/">Read the guide
          <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="band" data-od-id="hub-latest" aria-labelledby="latest-title">
    <div class="shell">
      <div class="section-head">
        <h2 id="latest-title">Latest in Music for Media</h2>
        <p>Newest first. Licensing pages state their review date, because these terms move.</p>
      </div>
      <ul class="index" data-reveal-group>
        <li data-reveal><a href="/publishing-roadmap/">
          <time class="index__date" datetime="2026-07-19">19 Jul 2026</time>
          <div>
            <h3>Production Music Licensing: A Practical Introduction</h3>
            <p>What the terms mean, who holds which right, and the questions to settle before a track is delivered.</p>
          </div>
          <div class="index__tail"><span class="index__topic">Guide · 18 min</span></div>
        </a></li>
        <li data-reveal><a href="/publishing-roadmap/">
          <time class="index__date" datetime="2026-07-05">05 Jul 2026</time>
          <div>
            <h3>Loudness and Delivery for Online Video</h3>
            <p>Target figures per platform, why they differ, and what happens to a master that ignores them.</p>
          </div>
          <div class="index__tail"><span class="index__topic">Delivery · 12 min</span></div>
        </a></li>
        <li data-reveal><a href="/publishing-roadmap/">
          <time class="index__date" datetime="2026-06-14">14 Jun 2026</time>
          <div>
            <h3>Composing Music for Wedding Films</h3>
            <p>Scoring an edit you did not cut, for a couple who will hear it a hundred times.</p>
          </div>
          <div class="index__tail"><span class="index__topic">Case study · 15 min</span></div>
        </a></li>
        <li data-reveal><a href="/publishing-roadmap/">
          <time class="index__date" datetime="2026-05-30">30 May 2026</time>
          <div>
            <h3>The Alternate Versions an Editor Will Ask For</h3>
            <p>Thirty, sixty, underscore, no-drums, and the one nobody remembers until the deadline.</p>
          </div>
          <div class="index__tail"><span class="index__topic">Delivery · 9 min</span></div>
        </a></li>
        <li data-reveal><a href="/publishing-roadmap/">
          <time class="index__date" datetime="2026-05-08">08 May 2026</time>
          <div>
            <h3>Rights and Delivery Checklist</h3>
            <p>Everything that must be cleared and named before a track leaves the studio.</p>
          </div>
          <div class="index__tail"><span class="index__topic">Checklist · 7 min</span></div>
        </a></li>
      </ul>
    </div>
  </section>

  <section class="band band--tight band-surface" data-od-id="hub-tail">
    <div class="shell tail">
      <div>
        <h2 style="font-size:var(--t-h3);margin-bottom:1.5rem">Terms used across this hub</h2>
        <dl class="glossary">
          <div>
            <dt>Sync licence</dt>
            <dd>Permission to synchronise a composition with moving images. Separate from the right to use a particular recording of it.</dd>
          </div>
          <div>
            <dt>Master rights</dt>
            <dd>The rights in a specific recording, as distinct from the rights in the underlying composition. Both are usually needed.</dd>
          </div>
          <div>
            <dt>LUFS</dt>
            <dd>Loudness Units relative to Full Scale — the measurement platforms normalise against, and the number a delivery specification will quote.</dd>
          </div>
          <div>
            <dt>Underscore</dt>
            <dd>A version mixed to sit beneath dialogue, usually with the melodic lead reduced or removed.</dd>
          </div>
        </dl>
      </div>
      <div>
        <h2 style="font-size:var(--t-h3);margin-bottom:1.5rem">Related</h2>
        <ul class="related">
          <li><a href="/music-production/">Production
            <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
          <li><a href="/recording/">Recording
            <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
          <li><a href="/resources/tools/delay-and-reverb/">Delay & Reverb calculator
            <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
          <li><a href="/about/editorial-policy/">Editorial policy
            <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
        </ul>
      </div>
    </div>
  </section>

  <section data-od-id="relaunch-notice">
    <div class="shell relaunch">
      <p>Auspicious Music was relaunched under new ownership in 2026. Historical
         references are preserved for context.</p>
      <a class="link" href="/about/history-and-relaunch/">Read the history and relaunch note
        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

</main>
</BaseLayout>