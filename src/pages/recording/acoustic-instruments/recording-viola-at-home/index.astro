  .sources a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .glossary-index { display: grid; gap: 0; }
  .glossary-index > div { padding-block: 1.25rem; border-top: 1px solid var(--line); }
  .glossary-index > div:last-child { border-bottom: 1px solid var(--line); }
  .glossary-index dt { font-size: 1.1875rem; font-weight: 550; letter-spacing: -0.012em; }
  .glossary-index dd { color: var(--ink-soft); font-size: 1.0625rem; line-height: 1.6; margin-top: 0.375rem; max-width: 64ch; }
  .glossary-index .tag {
    font-family: var(--font-mono); font-size: var(--t-meta); letter-spacing: var(--tr-meta);
    color: var(--muted); display: block; margin-top: 0.5rem;
