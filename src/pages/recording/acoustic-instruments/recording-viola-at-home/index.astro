<ArticleLayout
  title="A repeatable plan for recording viola at home"
  description="Prepare the room, compare three positions, name the takes and leave with material you can judge tomorrow — without invented microphone tests."
  canonicalPath="/recording/acoustic-instruments/recording-viola-at-home/"
  section="Recording"
