---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title={"How to Record Viola at Home — Auspicious Music"}
  description={"Microphone placement, room treatment you can do in a rented flat, and the three positions worth trying before anything else."}
  canonicalPath={"/recording/acoustic-instruments/recording-viola-at-home/"}
  lang={"en"}
  noindex={false}
  loadStringField={false}
>
<Fragment slot="head">
<style is:global>
@layer components {
  .art-head { padding-block: clamp(2rem, 4vw, 3rem) clamp(2rem, 4vw, 3rem); }
  .art-head h1 { max-width: 20ch; margin-top: 1.25rem; }
  .art-head .lede { margin-top: 1.5rem; max-width: 54ch; }

  .byline {
    display: flex; flex-wrap: wrap; gap: 0.75rem 2rem;
    margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--line);
    font-size: var(--t-ui-sm);
  }
  .byline div { display: grid; gap: 0.125rem; }
  .byline dt { font-family: var(--font-mono); font-size: var(--t-meta); letter-spacing: var(--tr-meta); color: var(--muted); }
  .byline__v { color: var(--ink); font-weight: 500; }

  .requires {
    margin-top: 2rem; border: 1px solid var(--line); border-radius: var(--r-md);
    background: var(--surface); padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .requires h2 {
    font-family: var(--font-mono); font-size: var(--t-meta); font-weight: 500;
    letter-spacing: var(--tr-meta); color: var(--muted); margin: 0 0 1rem;
  }
  .requires dl { display: grid; gap: 0.5rem; }
  .requires > dl > div {
    display: grid; grid-template-columns: minmax(7rem, 10rem) minmax(0, 1fr);
    gap: 0.5rem 1.25rem; padding-block: 0.4375rem;
    font-size: var(--t-ui-sm); line-height: 1.5;
  }
  .requires > dl > div + div { border-top: 1px solid var(--line); }
  .requires dt { color: var(--muted); }
  .requires dd { color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  @media (max-width: 560px) { .requires > dl > div { grid-template-columns: 1fr; gap: 0.1875rem; } }

  .art-grid { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  @media (min-width: 1080px) {
    .art-grid { grid-template-columns: 15rem minmax(0, 1fr); gap: 4.5rem; }
    .toc { position: sticky; top: calc(var(--header-h) + 24px); }
  }
  .toc summary {
    cursor: pointer; list-style: none;
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: var(--tr-meta); color: var(--muted);
    padding-block: 0.75rem; border-bottom: 1px solid var(--line);
    display: flex; justify-content: space-between; align-items: center;
    min-block-size: 44px;
  }
  .toc summary::-webkit-details-marker { display: none; }
  .toc summary::after { content: "−"; font-family: var(--font-mono); }
  .toc:not([open]) summary::after { content: "+"; }
  .toc ol { display: grid; gap: 0.125rem; padding-top: 0.75rem; counter-reset: toc; }
  .toc a {
    display: block; text-decoration: none; font-size: var(--t-ui-sm);
    line-height: 1.45; color: var(--muted); padding: 0.5rem 0 0.5rem 1.75rem;
    position: relative; transition: color var(--dur-fast) var(--ease);
  }
  .toc li { counter-increment: toc; }
  .toc a::before {
    content: counter(toc, decimal-leading-zero);
    position: absolute; left: 0; font-family: var(--font-mono);
    font-size: var(--t-meta); opacity: 0.7;
  }
  .toc a:hover { color: var(--ink); }

  .prose { max-width: var(--measure); }
  .prose > * + * { margin-top: 1.5rem; }
