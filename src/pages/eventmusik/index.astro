---
import ExpertHubLayout from '../../layouts/ExpertHubLayout.astro';
import { occasionProfiles } from '../../data/repertoire';
const decisions = [
  { title: 'Welcher Moment braucht Musik?', text: 'Ankunft, Einzug, Rede, Ritual, Empfang und Ausklang haben unterschiedliche Cue- und Längenanforderungen.', href: '/tools/eventmusik-planer/', label: 'Momente planen' },
  { title: 'Was erlaubt Ort und Ablauf?', text: 'Innenraum, Außenfläche, Wege, Aufbau, Schatten, Regenplan, Service und Moderation bestimmen, was praktisch funktioniert.', href: '/tools/eventmusik-planer/', label: 'Rahmen festhalten' },
  { title: 'Wann wird aus dem Plan eine Anfrage?', text: 'Wenn Anlass, Datum, Ort, Spielmomente und musikalische Richtung klar sind, kann Kim-Marie Verfügbarkeit und konkrete Optionen prüfen.', href: 'https://kim-marie-borger.com/', label: 'Zu Kim-Marie' },
];
const evidence = [
  { label: 'Planung statt Buchungsduplikat', text: 'Auspicious Music strukturiert die Entscheidung. Verfügbarkeit, Preis und Vertrag bleiben im direkten Buchungsprozess mit Kim-Marie.' },
  { label: 'Repertoire mit Grenzen', text: 'Die Titellisten stammen aus dem für diese Seite bestätigten Anlass-Repertoire. Eine Nennung bestätigt noch keine konkrete Fassung oder ein Arrangement.' },
  { label: 'Privat im Browser', text: 'Der Eventmusik-Planer speichert und versendet nichts. Er erzeugt einen Text, den du selbst kopierst, lädst oder als E-Mail-Entwurf öffnest.' },
];
const related = occasionProfiles.map((profile) => ({ title: profile.labelDe, description: profile.shortDe, href: `/eventmusik/${profile.slug}/`, meta: `${profile.pieces.length} Repertoire-Ideen` }));
---
<ExpertHubLayout title="Eventmusik, die zum Ablauf passt" description="Live-Viola für Hochzeit, Trauerfeier, Empfang, Dinner, Firmenevent, Geburtstag und Unterricht planen." canonicalPath="/eventmusik/" kicker="Planungshub · Kim-Marie Borger" intro="Gute Eventmusik beginnt nicht mit einer endlosen Titelliste. Sie beginnt mit Anlass, Menschen, Ort, Übergängen und der Frage, was die Musik in jedem Moment leisten soll." primary={{ href: '/tools/eventmusik-planer/', label: 'Eventmusik-Plan erstellen' }} secondary={{ href: 'https://kim-marie-borger.com/', label: 'Kim-Maries Buchungsseite', external: true }} decisions={decisions} evidence={evidence} related={related} lang="de">
  <figure class="expert-motif" slot="motif"><svg viewBox="0 0 420 240" fill="none" aria-hidden="true"><path d="M42 122H378" stroke="currentColor" opacity=".45"/><path d="M42 111v22M126 111v22M210 111v22M294 111v22M378 111v22" stroke="currentColor" opacity=".35"/><circle cx="126" cy="122" r="6" style="fill:var(--ember-bright)"/><circle cx="210" cy="122" r="6" fill="currentColor" opacity=".65"/><circle cx="294" cy="122" r="6" fill="currentColor" opacity=".65"/><path d="M126 84v-22h84v22M210 160v22h84v-22" stroke="currentColor" opacity=".35" stroke-dasharray="3 5"/></svg><figcaption>Moment, Cue und flexible Laenge vor der Titelwahl.</figcaption></figure>
</ExpertHubLayout>
