---
import ExpertHubLayout from '../../layouts/ExpertHubLayout.astro';
import { occasionProfiles } from '../../data/repertoire';
const decisions = [
  { title: 'Wo soll Musik erklingen?', text: 'Einzug, Unterschrift, Empfang, Rede und Ausklang sind verschiedene Aufgaben. Wählt nur die Momente aus, die in eurem Ablauf vorkommen.', href: '/tools/eventmusik-planer/', label: 'Momente auswählen' },
  { title: 'Was verändert der Ort?', text: 'Drinnen zählen Wege, Raum und Startzeichen. Draußen kommen Schatten, trockener Standort und ein konkreter Ausweichort hinzu.', href: '/eventmusik/live-streicher-draussen/', label: 'Draußen planen' },
  { title: 'Was muss vor der Anfrage feststehen?', text: 'Anlass, ungefährer Ort und die gewünschten Musikmomente reichen für den Anfang. Das Datum kann noch offen sein.', href: '/tools/eventmusik-planer/', label: 'Plan beginnen' },
];
const related = occasionProfiles.filter((profile) => profile.slug !== 'unterricht').map((profile) => ({ title: profile.labelDe, description: profile.shortDe, href: `/eventmusik/${profile.slug}/`, meta: `${profile.pieces.length} Repertoire-Ideen` }));
---
<ExpertHubLayout title="Musik für Hochzeit, Trauerfeier und Event" description="Musik für Hochzeit, Trauerfeier, Sektempfang, Dinner, Firmenevent oder Geburtstag auswählen und einen konkreten Ablauf vorbereiten." canonicalPath="/eventmusik/" kicker="Eventmusik planen" intro="Zuerst wird der Ablauf geklärt, dann die Musik. Wählt den Anlass, grenzt die Spielmomente ein und hört drei Stücke aus dem passenden Repertoire an." primary={{ href: '/tools/eventmusik-planer/', label: 'Musikplan erstellen' }} secondary={{ href: '/repertoire/', label: 'Repertoire ansehen' }} decisions={decisions} decisionsTitle="Drei Fragen vor der Titelauswahl" decisionsIntro="Damit aus Liedwünschen ein Ablauf wird." related={related} relatedTitle="Mit eurem Anlass anfangen" lang="de">
  <aside class="expert-motif expert-motif--text" slot="motif" aria-label="Was ein Musikplan klärt"><p>Ein brauchbarer Musikplan klärt</p><ol><li>welche Momente wirklich Musik brauchen,</li><li>welche Wirkung dort entstehen soll,</li><li>wer Start, Ende und Änderungen koordiniert.</li></ol></aside>
</ExpertHubLayout>
