---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={"Auspicious Music — Independent music production guides"}
  description={"An independent publication for music production, Ableton, recording, sound design, and music for media."}
  canonicalPath={"/"}
  lang={"en"}
  noindex={false}
  loadStringField={true}
  headerOverDark={true}
>
<Fragment slot="head">
<style is:global>
@layer components {

  /* ══ Hero ═══════════════════════════════════════════════════════════
     Revision 5 — the immersive stage.

     Revision 4 put the argument in typography and made the string
     playable, but it played on the same paper as everything after it,
     at 13% ink: the site's one recognisable gesture was a whisper.

     This pass moves the masthead onto the stage. Three architectures
     were weighed: an editorial split (type left, strings right) separates
     exactly the two things that must read as one instrument; an
     instrument-canvas on paper keeps the flatness that was the problem;
     the immersive stage wins because darkness is what makes a string
     visible — ivory lines under a high centre light, a copper node
     glowing where the pluck landed. The header goes transparent and the
     scene extends underneath it; the next section lays its paper edge
     over the stage floor, so the first viewport already promises a page
     to read. Still the only motion above the fold, still never loops,
     still stops dead at rest.                                          */
  .hero {
    position: relative;
    overflow: clip;
    /* The scene extends under the transparent header. */
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    /* Short of the full viewport by exactly the strip in which the next
       section's paper edge appears. */
    min-block-size: calc(100svh - 2rem);
    display: flex;
    background-color: var(--stage);
    background-image:
      radial-gradient(110% 85% at 50% -18%, rgba(243, 240, 233, 0.10), transparent 62%),
      radial-gradient(70% 55% at 88% 108%, rgba(43, 79, 215, 0.07), transparent 70%),
      linear-gradient(var(--stage-deep), var(--stage) 26%, var(--stage) 80%, var(--stage-deep));
    color: var(--stage-text);
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--grain);
    background-size: 160px 160px;
    opacity: 0.05;
    pointer-events: none;
  }
  .hero > .shell {
    position: relative;
    z-index: 1;                /* type sits above the string field */
    inline-size: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-block: clamp(2rem, 5vh, 4rem) 0;
  }

  /* Reference composition: editorial copy on the left, a working piece of
     the studio floating on the right. The string field still owns the
     whole stage behind both. */
  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
    align-self: center;
    padding-block: clamp(1rem, 3vh, 2.5rem);
  }
  @media (min-width: 1080px) {
    .hero__grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); }
  }

  .hero__note {
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--stage-muted);
    margin-top: 1.5rem;
  }

  .hero__title {
    font-size: clamp(2.75rem, 1.2rem + 5.8vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.042em;
    font-weight: 640;
    color: var(--stage-text);
  }
  .hero__title span { display: block; }

  .hero__actions { margin-top: 2rem; }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vh, 3rem);
    max-inline-size: 34rem;
  }
  .hero__stats .stat-tile span { white-space: normal; }
  @media (max-width: 520px) { .hero__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* The console: not a screenshot of a product — the product. The same
     arithmetic as the full calculator, floating over the stage the way
     the reference layouts float their dashboards. */
  .hero__console-wrap { position: relative; }
  .hero__console-wrap::before {
    content: "";
    position: absolute;
    inset: -12% -8%;
    background:
      radial-gradient(52% 48% at 30% 32%, rgba(43, 79, 215, 0.32), transparent 68%),
      radial-gradient(46% 44% at 76% 78%, rgba(196, 104, 31, 0.24), transparent 70%);
    filter: blur(6px);
    pointer-events: none;
  }
  .hero__console { max-inline-size: 34rem; margin-inline: auto; }
  @media (min-width: 1080px) and (prefers-reduced-motion: no-preference) {
    .hero__console {
      transform: perspective(1400px) rotateY(-8deg) rotateX(2.5deg);
      transition: transform 700ms var(--ease);
    }
    .hero__console:hover { transform: perspective(1400px) rotateY(-2deg) rotateX(0.5deg); }
  }
  .console-live { padding: clamp(1.25rem, 2.5vw, 1.75rem); display: grid; gap: 1.25rem; }
  .console-live label {
    display: block;
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: var(--tr-meta); color: var(--stage-muted);
    margin-bottom: 0.5rem;
  }
  .console-live input {
    inline-size: 100%;
    min-block-size: 52px;
    padding-inline: 1rem;
    border-radius: var(--r-control);
    border: 1px solid var(--stage-line);
    background: var(--stage-high);
    color: var(--stage-text);
    font-size: 1.5rem; font-weight: 615;
    font-variant-numeric: tabular-nums;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .console-live input:hover { border-color: var(--stage-muted); }
  .console-live :focus-visible { outline-color: var(--accent-on-dark); }
  .console-live__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;
  }
  .console-live__grid > div {
    border: 1px solid var(--stage-line-soft);
    border-radius: var(--r-sm);
    padding: 0.75rem 0.875rem;
    background: color-mix(in srgb, var(--stage-high) 45%, transparent);
  }
  .console-live__grid dt {
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: var(--tr-meta); color: var(--stage-muted);
  }
  .console-live__grid dd {
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.625rem);
    font-weight: 640; letter-spacing: -0.015em;
    font-variant-numeric: tabular-nums;
    margin-top: 0.125rem;
  }
  .console-live__grid small { font-size: 0.8125rem; font-weight: 500; color: var(--stage-muted); margin-left: 0.2rem; }
  .console-live__wave { display: flex; align-items: flex-end; gap: 3px; block-size: 34px; }
  .console-live__wave i {
    flex: 1;
    border-radius: 2px;
    background: var(--ember-bright);
    opacity: 0.65;
    block-size: calc(18% + var(--h, 30%));
  }
  .console-live__foot {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: var(--tr-meta); color: var(--stage-muted);
  }
  .console-live__foot a { color: var(--stage-text); }

  /* Short windows: scale gives way rather than the scene overflowing. */
  @media (min-width: 900px) and (max-height: 760px) {
    .hero__title { font-size: clamp(2.5rem, 1rem + 4.2vw, 4rem); }
    .hero__stats { margin-top: 1.5rem; }
  }

  /* The string field owns the whole stage, header strip included.
     Transparent to clicks so the type, the actions and the selection
     behaviour underneath are untouched; the pointer is read from .hero
     itself. Colour is decided here, not in the script: ivory lines,
     copper node — stage lighting, not document ink. */
  .hero__string {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
    z-index: 0;
    --string-line: var(--stage-text);
    --string-node: var(--ember-bright);
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    /* Content ends above the paper edge that the next section lays over
       the stage floor. */
    padding-bottom: calc(var(--sheet-overlap, 3.5rem) + clamp(1.5rem, 3vh, 2.25rem));
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero .btn--quiet { border-color: var(--stage-line); color: var(--stage-text); }
  .hero .btn--quiet:hover { border-color: var(--stage-text); background: var(--stage-raised); }
  .hero :focus-visible { outline-color: var(--accent-on-dark); }

  .hero__hint {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--tr-caps);
    text-transform: uppercase;
    color: var(--stage-muted);
    line-height: 1.6;
  }
  .hero__hint button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--stage-text);
    border-bottom: 1px solid var(--stage-line);
    padding-bottom: 1px;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .hero__hint button:hover { border-bottom-color: var(--stage-text); }


  .line-mask { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .line-mask > span { display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .line-mask > span { animation: line-in 620ms var(--ease-out) both; }
    .line-mask:nth-of-type(2) > span { animation-delay: 80ms; }
  }
  @keyframes line-in { from { transform: translateY(102%); } }

  /* ══ 2 · topic cards ════════════════════════════════════════════════
     Four lifted cards, each carrying its topic's diagram as a mark —
     the reference language (feature tiles) drawn in the house line
     vocabulary instead of icon fonts. */
  .topic-grid { display: grid; gap: clamp(1rem, 2vw, 1.5rem); }
  @media (min-width: 720px) { .topic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .topic-card {
    display: grid;
    gap: 0.625rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    align-content: start;
  }
  .topic-card svg { inline-size: 64px; block-size: 44px; color: var(--ink); margin-bottom: 0.5rem; }
  .topic-card h3 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); letter-spacing: -0.019em; }
  .topic-card p { color: var(--muted); font-size: 1rem; line-height: 1.6; max-width: 46ch; }
  .topic-card__go {
    display: inline-flex; align-items: center; gap: 0.4375rem;
    font-size: var(--t-ui-sm); font-weight: 550; margin-top: 0.375rem;
    transition: gap var(--dur-fast) var(--ease);
  }
  .topic-card:hover .topic-card__go { gap: 0.6875rem; color: var(--ember); }
  .topic-card__go svg { inline-size: 14px; block-size: 14px; margin: 0; }

  /* ══ 3 · start here ═════════════════════════════════════════════════ */
  .start { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 1000px) { .start { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 4.5rem; } }
  .start__lead h3 { font-size: clamp(1.625rem, 1.15rem + 1.7vw, 2.375rem); letter-spacing: -0.019em; margin-top: 1.25rem; }
  .start__lead p { color: var(--ink-soft); margin-top: 0.875rem; font-size: 1.0625rem; line-height: 1.6; max-width: 48ch; }
  .start__lead .meta { margin-top: 1.25rem; }
  .start__lead a { text-decoration: none; display: block; }
  .start__lead a:hover h3 { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .start__lead .ph { aspect-ratio: 16 / 10; background-color: var(--surface); box-shadow: var(--shadow-lift); }

  /* The reading list sits in a lifted panel rather than on bare rules. */
  ol.numbered {
    background: var(--surface-bright);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lift);
    padding-inline: clamp(1.25rem, 2.5vw, 1.75rem);
    overflow: clip;
  }
  .numbered li + li { border-top: 1px solid var(--line); }
  .numbered a {
    display: grid; grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.375rem 1rem; padding-block: 1.375rem; text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease);
  }
  .numbered a:hover { background: var(--surface); }
  .numbered__n {
    font-family: var(--font-mono); font-size: var(--t-meta);
    color: var(--muted); padding-top: 0.28rem; font-variant-numeric: tabular-nums;
  }
  .numbered h4 { font-size: 1.125rem; letter-spacing: -0.012em; }
  .numbered .meta { grid-column: 2; margin-top: 0.375rem; }

  /* ══ 4 · featured lab ═══════════════════════════════════════════════ */
  .lab__inner { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 1000px) { .lab__inner { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); } }
  .lab h2 { font-size: clamp(2rem, 1.15rem + 2.6vw, 3.25rem); max-width: 18ch; }
  .lab p { color: var(--dark-muted); margin-top: 1.25rem; max-width: 46ch; font-size: 1.0625rem; line-height: 1.65; }
  .lab .meta { margin-top: 1.75rem; }
  .lab .link { margin-top: 2rem; }
  .lab__art {
    border-radius: var(--r-media); overflow: hidden;
    background: var(--stage-raised);
    border: 1px solid var(--stage-line-soft);
    box-shadow: var(--shadow-float);
  }
  .lab__art img {
    inline-size: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: 55% 62%;
  }

  /* ══ 5 · tools ══════════════════════════════════════════════════════
     Three small applications, presented as applications: each card opens
     with a dark readout head showing a real computed value, labelled with
     the exact input it was computed from. Nothing is a mock number.    */
  .tools-band { background: var(--tint); }
  .tools-grid { display: grid; gap: clamp(1rem, 2vw, 1.5rem); }
  @media (min-width: 860px) { .tools-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .tool-app { overflow: clip; display: grid; grid-template-rows: auto 1fr; }
  .tool-app__head {
    background: linear-gradient(178deg, var(--stage-raised), var(--stage) 70%);
    color: var(--stage-text);
    padding: 1.25rem 1.375rem 1.375rem;
    display: grid;
    gap: 0.25rem;
  }
  .tool-app__head .app-frame__title { margin-bottom: 0.625rem; }
  .tool-app__value {
    font-size: clamp(1.875rem, 1.4rem + 1.6vw, 2.5rem);
    font-weight: 640; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .tool-app__value small { font-size: 1rem; font-weight: 500; color: var(--stage-muted); margin-left: 0.25rem; }
  .tool-app__ctx {
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: var(--tr-meta); color: var(--stage-muted);
  }
  .tool-app__body { padding: 1.25rem 1.375rem 1.5rem; display: grid; gap: 0.5rem; align-content: start; }
  .tool-app__body h3 { font-size: 1.25rem; letter-spacing: -0.014em; }
  .tool-app__body p { color: var(--muted); font-size: 0.9875rem; line-height: 1.55; }
  .tool-app__io {
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: var(--tr-meta); color: var(--ink-soft);
    margin-top: 0.375rem;
  }
  @media (min-width: 900px) {
    .tool-row a { grid-template-columns: minmax(0, 16rem) minmax(0, 1fr) minmax(0, 11rem); align-items: start; }
    .tool-row__io { text-align: right; padding-top: 0.3rem; }
  }

  /* ══ 6 · archive ════════════════════════════════════════════════════ */
  .records-grid { display: grid; gap: clamp(1rem, 2vw, 1.5rem); align-items: start; }
  @media (min-width: 860px) { .records-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .record { padding: clamp(1.5rem, 3vw, 2.25rem); }
  .record__grid { display: grid; gap: 1.25rem; }
  .record h3 { font-size: clamp(1.5rem, 1.15rem + 1.1vw, 2rem); letter-spacing: -0.017em; margin-top: 0.625rem; }
  .record p { color: var(--ink-soft); font-size: 1.0625rem; line-height: 1.65; max-width: 60ch; }
  .record__facts { display: grid; gap: 0.625rem; margin-top: 1.5rem; }
  .record .link { margin-top: 1.5rem; }
  .fact {
    display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 0.75rem;
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: var(--tr-meta); padding-block: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .fact dt { color: var(--muted); }
  .fact dd { color: var(--ink-soft); }
  @media (max-width: 560px) { .fact { grid-template-columns: 1fr; gap: 0.1875rem; } }

  /* ══ 7 · acoustic story ═════════════════════════════════════════════ */
  .story__media {
    position: relative; border-radius: var(--r-media); overflow: hidden;
    box-shadow: var(--shadow-media);
  }
  .story__media img { aspect-ratio: 16 / 9; object-fit: cover; }
  .story__body { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); margin-top: clamp(2rem, 4vw, 3rem); }
  @media (min-width: 900px) { .story__body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4rem; } }
  .story h2 { max-width: 16ch; }
  .story p { color: var(--ink-soft); font-size: 1.0625rem; line-height: 1.7; max-width: 56ch; }
  .story__links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; margin-top: 1.75rem; }

  /* ══ 8 · latest — the index in a lifted panel ═══════════════════════ */
  .index--panel {
    background: var(--surface-bright);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lift);
    padding-inline: clamp(1.25rem, 2.5vw, 1.75rem);
    overflow: clip;
  }
  .index--panel li:first-child a { border-top: none; }
}
</style>
</Fragment>

<main id="content">

  <!-- 1 ─────────────────────────────────────────────────────── hero -->
  <section class="hero" data-od-id="hero" data-stage-scene aria-labelledby="hero-title">
    <canvas class="hero__string" data-string aria-hidden="true"></canvas>

    <div class="shell">

      <div class="hero__grid">
        <div>
          <h1 id="hero-title" class="hero__title">
            <span>Make sound</span>
            <span>with intent.</span>
          </h1>
          <p class="hero__note">
            Practical, source-labelled guides for music production, Ableton, recording,
            sound design and music for media. Each page tells you what was tested, researched or preserved.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="/services/">Work with us</a>
            <a class="btn btn--quiet" href="/ableton/">Explore the guides</a>
          </div>
          <ul class="hero__stats">
            <li class="stat-tile"><strong>8</strong><span>source-labelled guides</span></li>
            <li class="stat-tile"><strong>3</strong><span>in-browser tools</span></li>
            <li class="stat-tile"><strong>23</strong><span>glossary terms</span></li>
          </ul>
        </div>

        <div class="hero__console-wrap">
          <div class="app-frame hero__console">
            <div class="app-frame__bar">
              <span class="app-frame__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="app-frame__title">delay-and-reverb — live</span>
            </div>
            <div class="console-live">
              <div>
                <label for="live-bpm">Your tempo · BPM</label>
                <input id="live-bpm" type="number" value="120" min="20" max="300" step="1" inputmode="decimal" autocomplete="off" />
              </div>
              <dl class="console-live__grid" aria-live="polite">
                <div><dt>1/4 note</dt><dd><span data-live-q>500.0</span><small>ms</small></dd></div>
                <div><dt>1/8 note</dt><dd><span data-live-e>250.0</span><small>ms</small></dd></div>
                <div><dt>1/4 dotted</dt><dd><span data-live-d>750.0</span><small>ms</small></dd></div>
                <div><dt>1/4 as rate</dt><dd><span data-live-hz>2.00</span><small>Hz</small></dd></div>
              </dl>
              <div class="console-live__wave" aria-hidden="true">
                <i style="--h:22%"></i><i style="--h:58%"></i><i style="--h:36%"></i><i style="--h:74%"></i><i style="--h:48%"></i><i style="--h:82%"></i><i style="--h:30%"></i><i style="--h:64%"></i><i style="--h:42%"></i><i style="--h:70%"></i><i style="--h:26%"></i><i style="--h:54%"></i><i style="--h:38%"></i><i style="--h:60%"></i><i style="--h:20%"></i><i style="--h:46%"></i>
              </div>
              <p class="console-live__foot">
                <span>Runs locally · nothing leaves the browser</span>
                <a href="/resources/tools/delay-and-reverb/">Full calculator →</a>
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="hero__foot">
        <p class="hero__hint">
          <button type="button" data-string-pluck>Play the strings</button> — drag one and the others answer.
        </p>
      </div>
    </div>
  </section>

  <!-- 2 · topic cards — the paper edge over the stage floor -->
  <section class="band band--tight sheet-lift band--glow" aria-labelledby="portals-title">
    <div class="shell" style="position:relative">
      <span class="rail" data-rail style="left:calc(var(--gutter) * -0.55)" aria-hidden="true"></span>
      <h2 id="portals-title" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)">Where to start by topic</h2>
      <div class="topic-grid" data-reveal-group>
        <a class="card topic-card" href="/ableton/" data-reveal>
