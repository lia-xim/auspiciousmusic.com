<Fragment slot="scripts">
<script is:inline>
/* Live tempo strip — the same arithmetic as the full calculator, inline so
   the homepage tool band is something you use, not something described. */
(function () {
  "use strict";
  var input = document.getElementById("live-bpm");
  if (!input) return;
  var q = document.querySelector("[data-live-q]");
  var e = document.querySelector("[data-live-e]");
  var d = document.querySelector("[data-live-d]");
  var hz = document.querySelector("[data-live-hz]");
  var render = function () {
    var bpm = parseFloat(input.value);
    if (!isFinite(bpm) || bpm <= 0) return;
    bpm = Math.min(300, Math.max(20, bpm));
    var quarter = 60000 / bpm;
    q.textContent = quarter.toFixed(1);
    e.textContent = (quarter / 2).toFixed(1);
    d.textContent = (quarter * 1.5).toFixed(1);
    hz.textContent = (1000 / quarter).toFixed(2);
  };
  input.addEventListener("input", render);
  render();
})();
</script>
