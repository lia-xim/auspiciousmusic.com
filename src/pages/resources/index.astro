---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title={"Music Production Resources — Auspicious Music"}
  description={"Calculators, templates, a working glossary and the archive of everything once published at this address."}
  canonicalPath={"/resources/"}
  lang={"en"}
  noindex={false}
  loadStringField={false}
>
<Fragment slot="head">
<style is:global>
@layer components {
  .pg-head { padding-block: clamp(2rem, 4vw, 3rem) clamp(2.5rem, 5vw, 3.5rem); }
  .pg-head h1 { max-width: 17ch; margin-top: 1.25rem; }
  .pg-head .lede { margin-top: 1.5rem; max-width: 58ch; }
  .pg-head--dark { background: var(--dark); color: var(--dark-text); padding-block: clamp(2.5rem, 5vw, 4rem); }
  .pg-head--dark .crumbs { color: var(--dark-muted); }
  .pg-head--dark .crumbs a:hover { color: var(--dark-text); }
  .pg-head--dark .lede { color: var(--dark-muted); }

  .prose { max-width: var(--measure); }
  .prose > * + * { margin-top: 1.5rem; }
  .prose h2 { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); letter-spacing: -0.016em; margin-top: clamp(2.75rem, 5vw, 3.75rem); }
  .prose h3 { font-size: 1.25rem; margin-top: 2rem; letter-spacing: -0.012em; }
  .prose p { color: var(--ink-soft); }
  .prose a:not(.link):not(.btn) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .rule-list li {
    padding-block: 1rem; border-top: 1px solid var(--line);
    display: grid; grid-template-columns: 1.75rem minmax(0, 1fr); gap: 0.75rem;
    color: var(--ink-soft); line-height: 1.65;
  }
  .rule-list li:last-child { border-bottom: 1px solid var(--line); }
  .rule-list li::before {
    content: ""; inline-size: 7px; block-size: 7px; border-radius: 50%;
    background: transparent; box-shadow: inset 0 0 0 2px var(--line-strong); margin-top: 0.62rem;
  }
  .rule-list strong { color: var(--ink); display: block; margin-bottom: 0.25rem; }

  .callout { border-left: 2px solid var(--ink); padding: 0.25rem 0 0.25rem 1.5rem; }
  .callout strong { display: block; margin-bottom: 0.375rem; }
  .callout p { color: var(--ink); }

  .facts { display: grid; gap: 0; border-top: 1px solid var(--dark-line); margin-top: clamp(2rem, 4vw, 3rem); }
  .facts > div {
    display: grid; grid-template-columns: minmax(8rem, 12rem) minmax(0, 1fr);
    gap: 0.5rem 1.5rem; padding-block: 0.875rem;
    border-bottom: 1px solid var(--dark-line-soft);
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: var(--tr-meta); line-height: 1.6;
  }
  .facts dt { color: var(--dark-muted); }
  .facts dd { color: var(--dark-text); }
  @media (max-width: 560px) { .facts > div { grid-template-columns: 1fr; gap: 0.1875rem; } }

  .timeline { position: relative; padding-left: 2rem; }
  .timeline::before { content: ""; position: absolute; left: 3px; top: 1.2rem; bottom: 1.2rem; width: 1px; background: var(--line-strong); }
  .timeline li { position: relative; padding-block: 1.125rem; }
  .timeline li + li { border-top: 1px solid var(--line); }
  .timeline li::before {
    content: ""; position: absolute; left: -2rem; top: 1.7rem;
    inline-size: 7px; block-size: 7px; border-radius: 50%;
    background: var(--canvas); box-shadow: inset 0 0 0 2px var(--line-strong);
  }
  .timeline li:last-child::before { background: var(--ember-bright); box-shadow: none; }
  .timeline time { font-family: var(--font-mono); font-size: var(--t-meta); letter-spacing: var(--tr-meta); color: var(--muted); display: block; margin-bottom: 0.375rem; }
  .timeline h3 { font-size: 1.125rem; letter-spacing: -0.011em; margin: 0 0 0.375rem; }
  .timeline p { color: var(--ink-soft); font-size: 1rem; line-height: 1.6; max-width: 58ch; }

  .listing li { border-top: 1px solid var(--line); }
  .listing li:last-child { border-bottom: 1px solid var(--line); }
  .listing a {
    display: grid; gap: 0.375rem 2.5rem; padding-block: 1.375rem;
    text-decoration: none; align-items: baseline;
    transition: background-color var(--dur-fast) var(--ease);
  }
  .listing a:hover { background: var(--surface); }
  .listing h3 { font-size: 1.25rem; letter-spacing: -0.014em; }
  .listing p { color: var(--muted); font-size: 1rem; line-height: 1.55; max-width: 58ch; }
  .listing__tail { font-family: var(--font-mono); font-size: var(--t-meta); letter-spacing: var(--tr-meta); color: var(--muted); }
  @media (min-width: 900px) {
    .listing a { grid-template-columns: minmax(0, 16rem) minmax(0, 1fr) minmax(0, 9rem); align-items: start; }
    .listing__tail { text-align: right; padding-top: 0.3rem; }
  }

  .glossary > div { padding-block: 1.125rem; border-top: 1px solid var(--line); }
  .glossary > div:last-child { border-bottom: 1px solid var(--line); }
  .glossary dt { font-weight: 550; font-size: 1.0625rem; letter-spacing: -0.01em; }
  .glossary dd { color: var(--muted); font-size: 1rem; line-height: 1.6; margin-top: 0.25rem; max-width: 60ch; }

  .sources { margin-top: clamp(2.5rem, 5vw, 3.5rem); padding-top: 2rem; border-top: 1px solid var(--line); }
  .sources h2 { font-size: var(--t-h3); margin: 0 0 1.25rem; }
  .sources ol { display: grid; gap: 0.875rem; counter-reset: src; }
  .sources li { counter-increment: src; padding-left: 2rem; position: relative; font-size: 1rem; line-height: 1.6; color: var(--muted); }
  .sources li::before { content: counter(src); position: absolute; left: 0; font-family: var(--font-mono); font-size: var(--t-meta); }
  .sources a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
}
</style>
</Fragment>

<main id="content">

  <section class="pg-head" data-od-id="page-head">
    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li>Resources</li>
        </ol>
      </nav>
      
      <h1>Resources</h1>
      <p class="lede">The parts of this publication that are not articles: calculators you can use mid-session, templates, a glossary that defines terms the way they are used here, and the archive.</p>
      
    </div>
  </section>


  <section class="band band--tight" data-od-id="res-tools" aria-labelledby="tools-title">
    <div class="shell">
      <div class="section-head">
        <h2 id="tools-title">Tools</h2>
        <p>Everything runs in your browser. Nothing is stored, nothing is sent anywhere, and there is nothing to sign in to.</p>
      </div>
      <ul class="listing" data-reveal-group>
        <li data-reveal><a href="/resources/tools/delay-and-reverb/">
          <h3>Delay &amp; Reverb Time</h3>
          <p>Note divisions in milliseconds and hertz at any tempo, straight, dotted and triplet, with tap tempo and reverb starting points.</p>
          <span class="listing__tail">BPM → ms · Hz</span>
        </a></li>
        <li data-reveal><a href="/resources/tools/note-frequency/">
          <h3>Note &amp; Frequency</h3>
          <p>Notes, MIDI numbers and frequencies both ways at a settable concert pitch, with cents deviation and wavelength.</p>
          <span class="listing__tail">Note ⇄ Hz ⇄ MIDI</span>
        </a></li>
        <li data-reveal><a href="/resources/tools/sample-pitch/">
          <h3>Sample Pitch &amp; Rate</h3>
          <p>Transposition against playback rate, length and tempo, plus sample-rate mismatch expressed in semitones.</p>
          <span class="listing__tail">Semitones → rate</span>
        </a></li>
      </ul>
      <p style="margin-top:2rem"><a class="link" href="/resources/tools/">All tools and what is planned <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
    </div>
  </section>

  <section class="band band--tight band-surface" data-od-id="res-templates" aria-labelledby="templates-title">
    <div class="shell">
      <div class="section-head">
        <h2 id="templates-title">Templates</h2>
        <p>Project files and checklists. None are published yet — each needs a licence, a version and a checksum before it goes live.</p>
      </div>
      <ul class="rule-list" style="max-width:52rem">
        <li><div><strong>Ableton Live project template</strong>Track order, return layout and naming, built from the DAW project guidelines. In preparation.</div></li>
        <li><div><strong>Delivery checklist for media work</strong>Stems, alternates, metadata and loudness targets in one page. In preparation.</div></li>
        <li><div><strong>Session sheet for sampling</strong>The planning sheet used in the sampled-instrument build. In preparation.</div></li>
      </ul>
      <p style="margin-top:1.5rem;color:var(--muted);font-size:1rem;max-width:56ch;line-height:1.6">
        The requirements every downloadable file must meet before publication are listed
        on the <a href="/download/" style="color:var(--accent);text-decoration:underline;text-underline-offset:3px">archive page</a>.
      </p>
    </div>
  </section>

  <section class="band band--tight" id="glossary" data-od-id="res-glossary" aria-labelledby="glossary-title">
    <div class="shell">
      <div class="section-head">
        <h2 id="glossary-title">Glossary</h2>
        <p>Terms as this publication uses them. Where usage differs between DAWs or between disciplines, the difference is stated rather than smoothed over.</p>
      </div>
      <!-- The full glossary is its own page. This section shows the entries
           the resources above depend on and links onward, rather than
           maintaining a second, shorter list that drifts out of step. -->
      <dl class="glossary" style="max-width:52rem">
        <div><dt>Collect All and Save</dt><dd>The Live command that copies every referenced sample into the project folder. The single step that decides whether a session opens on another machine.</dd></div>
        <div><dt>Round-robin</dt><dd>Cycling through several recordings of the same note so repeats do not sound identical. Random selection can repeat; cyclic selection cannot.</dd></div>
        <div><dt>Pre-delay</dt><dd>The gap between a dry signal and the first reflections of a reverb. Long enough and the transient stays clear; too long and the effect detaches.</dd></div>
        <div><dt>Room mode</dt><dd>A standing wave at a frequency whose wavelength fits a dimension of the room, making some notes far louder in some positions than others.</dd></div>
      </dl>
      <p style="margin-top:2rem">
        <a class="link" href="/resources/glossary/">All 23 terms
          <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </p>
    </div>
  </section>

  <section class="band band--tight band-surface" data-od-id="res-archive" aria-labelledby="archive-title">
    <div class="shell">
      <div class="section-head">
        <h2 id="archive-title">Archive</h2>
        <p>Everything published at this address before the relaunch, with its actual status.</p>
      </div>
      <ul class="listing" data-reveal-group>
        <li data-reveal><a href="/download/">
          <h3>Legacy downloads</h3>
          <p>Six historic resources, each with its rights position and current availability stated plainly.</p>
          <span class="listing__tail">6 entries</span>
        </a></li>
        <li data-reveal><a href="/legacy/the-spy-guitar/">
          <h3>The Spy Guitar</h3>
          <p>An Ableton sampler instrument from 2013, with a current guide that rebuilds the same result from scratch.</p>
          <span class="listing__tail">2013 – 2017</span>
        </a></li>
        <li data-reveal><a href="/legacy/bang-my-twister/">
          <h3>Bang My Twister</h3>
          <p>A Max for Live device for the MIDI Fighter Twister, with its still-maintained external source.</p>
          <span class="listing__tail">2014</span>
        </a></li>
      </ul>
    </div>
  </section>

  <section data-od-id="relaunch-notice">
    <div class="shell relaunch">
      <p>Auspicious Music is being prepared as a new, independent publication. The domain&apos;s
         former operator is not affiliated with this relaunch.</p>
      <a class="link" href="/about/history-and-relaunch/">Read the history and relaunch note
        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

</main>
</BaseLayout>