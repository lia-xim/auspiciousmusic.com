---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';
---

<BaseLayout title="Journal — Auspicious Music" description="All published Auspicious Music guides, with topic, method and reading time." canonicalPath="/journal/" lang="en">
  <Fragment slot="head"><style is:global>
    @layer components {
      .journal-head { padding-block: clamp(2.5rem, 6vw, 5rem); border-bottom: 1px solid var(--line); }
      .journal-head h1 { margin-top: 1.2rem; }
      .journal-head .lede { margin-top: 1.4rem; max-width: 55ch; }
      .journal-list { border-top: 1px solid var(--line-strong); }
      .journal-list li { border-bottom: 1px solid var(--line); }
      .journal-list a { display: grid; gap: .6rem 2.5rem; padding-block: 1.7rem; text-decoration: none; }
      .journal-list a:hover { background: var(--surface); }
      .journal-list h2 { font-size: clamp(1.35rem, 1.1rem + .8vw, 1.9rem); }
      .journal-list p { color: var(--muted); max-width: 58ch; font-size: 1rem; line-height: 1.55; }
      @media (min-width: 920px) { .journal-list a { grid-template-columns: minmax(16rem, 1fr) minmax(20rem, 1.3fr) 11rem; align-items: start; } .journal-list .meta { justify-self: end; text-align: right; } }
    }
  </style></Fragment>
  <main id="content">
    <header class="journal-head"><div class="shell"><p class="kicker">Article index</p><h1>Journal</h1><p class="lede">Eight focused guides form the first editorial release. All were published on 11 August 2026; none are backdated to imitate the domain’s earlier publication.</p></div></header>
    <section class="band"><div class="shell"><ul class="journal-list">{articles.map((article) => <li><a href={article.href}><h2>{article.title}</h2><p>{article.description}</p><span class="meta">{article.section} · {article.minutes} min</span></a></li>)}</ul></div></section>
  </main>
</BaseLayout>
