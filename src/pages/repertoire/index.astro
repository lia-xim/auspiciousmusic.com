---
import ExpertHubLayout from '../../layouts/ExpertHubLayout.astro';
import { occasionProfiles } from '../../data/repertoire';
const decisions = [
  { title: 'Nach Funktion wählen', text: 'Ein Einzug braucht einen klaren Beginn, Hintergrundmusik flexible Übergänge und ein Gedenkmoment bewusste Ruhe.', href: '/tools/eventmusik-planer/', label: 'Funktion festlegen' },
  { title: 'Fassung statt nur Titel prüfen', text: 'Tonumfang, Textur, Wiedererkennbarkeit, Notenlage und Vorbereitung entscheiden, ob ein Werk auf Solo-Viola in diesem Moment funktioniert.', href: '/tools/wunschstueck-check/', label: 'Wunschstück vorbereiten' },
  { title: 'Rechte und Verfügbarkeit trennen', text: 'Live-Auftritt, Aufnahme, Video und Notenvervielfaeltigung sind unterschiedliche Nutzungen. Hier werden keine geschützten Noten oder Texte veröffentlicht.', href: '/about/editorial-policy/', label: 'Redaktionelle Regeln' },
];
const evidence = [
  { label: 'Bestätigte Startliste', text: 'Die hier genannten Titel wurden für die Anlasslisten dieser Seite von der Projektseite bereitgestellt. Das ist eine Planungsgrundlage, keine Termin- oder Fassungszusage.' },
  { label: 'Offene Varianten sichtbar', text: 'Bei Ordinary, Ave Maria und Rieding Concerto / Concertino bleibt die genaue Interpretation beziehungsweise das Werk bewusst als Klärpunkt stehen.' },
  { label: 'Keine Noten oder Songtexte', text: 'Die Seite nennt Titel und Planungsfunktion, vervielfältigt aber keine geschützten Noten, Arrangements, Texte oder Aufnahmen.' },
];
const related = occasionProfiles.map((profile) => ({ title: profile.labelDe, description: profile.pieces.map((piece) => piece.title).slice(0, 3).join(' · '), href: `/eventmusik/${profile.slug}/`, meta: `${profile.pieces.length} Titel` }));
---
<ExpertHubLayout title="Repertoire nach Anlass" description="Repertoire-Ideen für Live-Viola bei Hochzeit, Empfang, Trauerfeier, Dinner, Firmenevent, Geburtstag und Unterricht." canonicalPath="/repertoire/" kicker="Gepflegte Repertoire-Referenz" intro="Eine Titelliste wird erst dann hilfreich, wenn klar ist, wofür die Musik gebraucht wird. Wähle den Anlass, prüfe Spielmoment und Rahmen und nimm die passenden Titel als Ausgangspunkt ins Gespräch." primary={{ href: '/tools/wunschstueck-check/', label: 'Eigenes Wunschstück prüfen' }} secondary={{ href: '/tools/eventmusik-planer/', label: 'Repertoire im Planer auswählen' }} decisions={decisions} evidence={evidence} related={related} lang="de">
  <figure class="expert-motif" slot="motif"><svg viewBox="0 0 420 240" fill="none" aria-hidden="true"><path d="M70 72H350M70 96H350M70 120H350M70 144H350M70 168H350" stroke="currentColor" opacity=".25"/><path d="M126 66v72c0 19-31 26-31 7 0-13 20-21 31-12M252 92v72c0 19-31 26-31 7 0-13 20-21 31-12" stroke="currentColor" stroke-width="2"/><path d="M126 66l126 26" style="stroke:var(--ember-bright)" stroke-width="2"/><circle cx="188" cy="79" r="5" style="fill:var(--ember-bright)"/></svg><figcaption>Anlass, Funktion und Machbarkeit vor der Zusage.</figcaption></figure>
</ExpertHubLayout>
