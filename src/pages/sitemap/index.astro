---
import BaseLayout from '../../layouts/BaseLayout.astro';
import records from '../../data/migrated-pages.json';
import { isSearchLanding } from '../../data/index-policy';
const pages = records.filter((record) => !record.internal && record.indexable !== false && isSearchLanding(record.route) && !['/404/', '/410/'].includes(record.route));
---
<BaseLayout title="Sitemap — Auspicious Music" description="Alle öffentlichen Fach-, Werkzeug-, Archiv- und Informationsseiten von Auspicious Music." canonicalPath="/sitemap/" lang="de" noindex={true}>
  <main id="content"><section class="band"><div class="shell"><p class="kicker">Navigation</p><h1 style="margin-top:1rem">Sitemap</h1><p class="lede" style="margin-top:1.5rem;max-width:55ch">Alle öffentlichen Fach-, Werkzeug-, Archiv- und Informationsseiten. Interne Entwürfe, Statusseiten und stillgelegte Routen sind ausgeschlossen.</p><ul class="index" style="margin-top:3rem">{pages.map((page) => <li><a href={page.route}><span class="index__date">{page.route}</span><div><h2>{page.h1.replaceAll('&amp;', '&')}</h2><p>{page.description}</p></div></a></li>)}</ul></div></section></main>
</BaseLayout>
