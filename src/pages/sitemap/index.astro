---
import BaseLayout from '../../layouts/BaseLayout.astro';
import records from '../../data/migrated-pages.json';
const pages = records.filter((record) => !record.internal && !['/404/', '/410/'].includes(record.route));
---
<BaseLayout title="Sitemap — Auspicious Music" description="Every public editorial, resource, archive and publication page on Auspicious Music." canonicalPath="/sitemap/" lang="en">
  <main id="content"><section class="band"><div class="shell"><p class="kicker">Navigation</p><h1 style="margin-top:1rem">Sitemap</h1><p class="lede" style="margin-top:1.5rem;max-width:55ch">All public editorial, archive, resource and publication pages. Internal design documents and retired roadmap routes are excluded.</p><ul class="index" style="margin-top:3rem">{pages.map((page) => <li><a href={page.route}><span class="index__date">{page.route}</span><div><h2>{page.h1.replaceAll('&amp;', '&')}</h2><p>{page.description}</p></div></a></li>)}</ul></div></section></main>
</BaseLayout>
