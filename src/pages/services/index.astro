---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title={"Live Viola & String Recording — Auspicious Music"}
  description={"Book live viola for ceremonies and events, session viola recording, or music for small productions — the practice behind this publication's guides."}
  canonicalPath={"/services/"}
  lang={"en"}
  noindex={false}
  loadStringField={false}
  headerOverDark={true}
>
<Fragment slot="head">
<style is:global>
@layer components {
  /* ── services: the page every other page leads to ─────────────────────
     Same landing grammar as the homepage and the hubs: ink stage under a
     transparent header, an enquiry console floating on the right, the
     paper edge carrying the offers. */
  .svc-head {
    position: relative;
    overflow: clip;
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + clamp(1.5rem, 4vh, 3rem));
    padding-bottom: calc(var(--sheet-overlap) + clamp(2.5rem, 5vh, 4rem));
    background-color: var(--stage);
    background-image:
      radial-gradient(110% 85% at 50% -18%, rgba(243, 240, 233, 0.10), transparent 62%),
      radial-gradient(70% 55% at 88% 108%, rgba(43, 79, 215, 0.07), transparent 70%),
      linear-gradient(var(--stage-deep), var(--stage) 26%, var(--stage) 80%, var(--stage-deep));
    color: var(--stage-text);
  }
  .svc-head::before {
    content: ""; position: absolute; inset: 0;
    background: var(--grain); background-size: 160px 160px;
    opacity: 0.05; pointer-events: none;
  }
  .svc-head > * { position: relative; }
  .svc-head .kicker { color: var(--stage-muted); }
  .svc-head :focus-visible { outline-color: var(--accent-on-dark); }
  .svc-head__grid { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 1080px) { .svc-head__grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); } }
  .svc-head h1 {
    max-width: 15ch; margin-top: 1.2rem;
    font-size: clamp(2.5rem, 1.2rem + 4.6vw, 4.75rem);
    line-height: 0.98; letter-spacing: -0.038em; font-weight: 640;
    color: var(--stage-text);
  }
  .svc-head .lede { max-width: 50ch; margin-top: 1.5rem; color: var(--stage-muted); }
  .svc-head__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .svc-head .btn--quiet { border-color: var(--stage-line); color: var(--stage-text); }
  .svc-head .btn--quiet:hover { border-color: var(--stage-text); background: var(--stage-raised); }

  /* Enquiry console — what a useful first email contains. */
  .svc-console-wrap { position: relative; }
  .svc-console-wrap::before {
    content: ""; position: absolute; inset: -12% -8%;
    background:
      radial-gradient(52% 48% at 32% 30%, rgba(43, 79, 215, 0.30), transparent 68%),
      radial-gradient(46% 44% at 74% 80%, rgba(196, 104, 31, 0.22), transparent 70%);
    filter: blur(6px); pointer-events: none;
  }
  .svc-console { max-inline-size: 33rem; margin-inline: auto; }
  @media (min-width: 1080px) and (prefers-reduced-motion: no-preference) {
    .svc-console {
      transform: perspective(1400px) rotateY(-7deg) rotateX(2deg);
      transition: transform 700ms var(--ease);
    }
    .svc-console:hover { transform: perspective(1400px) rotateY(-2deg) rotateX(0.5deg); }
  }
  .svc-console__body { padding: clamp(1.25rem, 2.5vw, 1.75rem); display: grid; gap: 1rem; }
  .svc-console__body dl { display: grid; gap: 0.625rem; }
  .svc-console__body dt {
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: var(--tr-meta); color: var(--ember-on-dark);
  }
  .svc-console__body dd { font-size: 0.9875rem; line-height: 1.5; color: var(--stage-text); }
  .svc-console__foot {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem;
    padding-top: 0.5rem; border-top: 1px solid var(--stage-line-soft);
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: var(--tr-meta); color: var(--stage-muted);
  }

  /* Offer cards on the paper edge */
  .svc-grid { display: grid; gap: clamp(1rem, 2vw, 1.5rem); }
  @media (min-width: 960px) { .svc-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .svc-card { display: grid; align-content: start; gap: 0.625rem; padding: clamp(1.5rem, 3vw, 2.25rem); }
  .svc-card h2 { font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.75rem); letter-spacing: -0.018em; }
  .svc-card > p { color: var(--muted); font-size: 1rem; line-height: 1.6; }
  .svc-card__for {
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: var(--tr-meta); color: var(--ember);
  }
  .svc-card__method {
    margin-top: 0.625rem; padding-top: 0.875rem;
    border-top: 1px solid var(--line);
    font-size: var(--t-ui-sm); line-height: 1.55; color: var(--ink-soft);
  }
  .svc-card__method a { color: var(--accent); text-underline-offset: 3px; }

  /* Who plays */
  .svc-who { display: grid; gap: 2rem 4rem; align-items: start; }
  @media (min-width: 960px) { .svc-who { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); } }
  .svc-who p { color: var(--ink-soft); font-size: 1.0625rem; line-height: 1.7; max-width: 56ch; }
  .svc-who .link { margin-top: 1rem; display: inline-flex; }
  .svc-facts { display: grid; }
  .svc-facts > div {
    display: grid; grid-template-columns: minmax(8rem, 11rem) minmax(0, 1fr);
    gap: 0.5rem 1.5rem; padding-block: 0.875rem;
    border-top: 1px solid var(--line);
    font-size: 0.9875rem; line-height: 1.55;
  }
  .svc-facts > div:last-child { border-bottom: 1px solid var(--line); }
  .svc-facts dt { font-family: var(--font-mono); font-size: var(--t-meta); letter-spacing: var(--tr-meta); color: var(--muted); }
  .svc-facts dd { color: var(--ink-soft); }

  /* Process */
  .svc-steps { display: grid; gap: clamp(1rem, 2vw, 1.5rem); counter-reset: svc; }
  @media (min-width: 900px) { .svc-steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .svc-step { counter-increment: svc; padding: 1.375rem 1.5rem; align-content: start; display: grid; gap: 0.5rem; }
  .svc-step::before {
    content: counter(svc, decimal-leading-zero);
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: var(--tr-meta); color: var(--ember);
  }
  .svc-step h3 { font-size: 1.125rem; letter-spacing: -0.012em; }
  .svc-step p { color: var(--muted); font-size: 0.95rem; line-height: 1.55; }
}
</style>
</Fragment>

<main id="content">

  <!-- hero -->
  <section class="svc-head" data-stage-scene aria-labelledby="svc-title">
    <div class="shell">
      <div class="svc-head__grid">
        <div>
          <p class="kicker">Work with us</p>
          <h1 id="svc-title">The practice behind the guides.</h1>
          <p class="lede">
            Every guide on this site describes work that actually happens — ceremonies
            played, sessions recorded, deliveries packaged. That practice is bookable:
            live viola for the moments that matter, and strings for the productions
            that need them.
          </p>
          <div class="svc-head__actions">
            <a class="btn btn--primary" href="mailto:info@matthiasramahi.de?subject=Enquiry%20%E2%80%94%20Auspicious%20Music">Start an enquiry</a>
            <a class="btn btn--quiet" href="https://kim-marie-borger.com/" rel="noopener external">Hear the playing →</a>
          </div>
        </div>

        <div class="svc-console-wrap">
          <div class="app-frame svc-console">
            <div class="app-frame__bar">
              <span class="app-frame__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="app-frame__title">enquiry — what helps us answer fast</span>
            </div>
            <div class="svc-console__body">
              <dl>
                <div><dt>OCCASION</dt><dd>Ceremony, event, session or production — one sentence is enough.</dd></div>
                <div><dt>DATE · PLACE</dt><dd>When and where, even roughly. “Summer, near Düsseldorf” works.</dd></div>
                <div><dt>SCOPE</dt><dd>Which moments need music, or how many parts need recording.</dd></div>
              </dl>
              <p class="svc-console__foot">
                <span>German or English · reply within days</span>
                <a href="mailto:info@matthiasramahi.de?subject=Enquiry%20%E2%80%94%20Auspicious%20Music" style="color:var(--stage-text)">Write the email →</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- offers on the paper edge -->
  <section class="band sheet-lift band--glow" aria-labelledby="offers-title">
    <div class="shell" style="padding-top: clamp(1.5rem, 3vw, 2.5rem)">
      <h2 id="offers-title" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)">What can be booked</h2>
      <div class="svc-grid" data-reveal-group>
        <article class="card svc-card" data-reveal>
          <span class="svc-card__for">CEREMONIES · EVENTS</span>
          <h2>Live viola</h2>
          <p>
            Weddings, funerals, baptisms, receptions and corporate occasions —
            planned around the moments that carry the day, with timing ranges and
            clear cues instead of a rigid running order.
          </p>
          <p class="svc-card__method">
            The planning method is public: <a href="/music-for-media/planning-live-viola-for-a-wedding-ceremony/">how a ceremony is planned</a> —
            the same process every booking goes through.
          </p>
        </article>
        <article class="card svc-card" data-reveal>
          <span class="svc-card__for">PRODUCTIONS · SESSIONS</span>
          <h2>Session viola &amp; string recording</h2>
          <p>
            A real player for the part you decided not to fake — recorded with
            documented microphone practice, delivered as clean takes your session
            can actually use.
          </p>
          <p class="svc-card__method">
            Decide first with <a href="/sound-design/when-to-record-strings-instead-of-using-a-library/">record or library?</a>,
            then see <a href="/recording/acoustic-instruments/viola-microphone-placement/">how the recording is made</a>.
          </p>
        </article>
        <article class="card svc-card" data-reveal>
          <span class="svc-card__for">FILM · SMALL PRODUCTIONS</span>
          <h2>Music for media</h2>
          <p>
            String parts and music for small film and media projects — briefed by
            function, cleared properly and handed off in a form the production
            keeps working with.
          </p>
          <p class="svc-card__method">
            The delivery standard is public: <a href="/music-for-media/music-clearance-for-small-film-projects/">rights before edit lock</a> and
            <a href="/music-production/ableton-project-handoff/">a handoff that opens</a>.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- who plays -->
  <section class="band" aria-labelledby="who-title">
    <div class="shell svc-who">
      <div>
        <div class="section-head" style="margin-bottom:1.25rem"><div><p class="kicker">Who plays</p><h2 id="who-title">Kim-Marie Borger, viola</h2></div></div>
        <p>
          The live and session work is performed by Kim-Marie Borger — a violist
          currently studying viola at degree level, who has accompanied ceremonies
          and events across Germany for several years. Recordings and sound samples
          are on her own site, where they belong: played, not described.
        </p>
        <a class="link" href="https://kim-marie-borger.com/" rel="noopener external">Listen on kim-marie-borger.com →</a>
      </div>
      <dl class="svc-facts">
        <div><dt>INSTRUMENT</dt><dd>Viola — with violin available for lessons and select occasions</dd></div>
        <div><dt>BASE</dt><dd>North Rhine-Westphalia, working across Germany</dd></div>
        <div><dt>LANGUAGES</dt><dd>German and English</dd></div>
        <div><dt>SOUND SAMPLES</dt><dd><a href="https://kim-marie-borger.com/" rel="noopener external" style="color:var(--accent)">On her site</a> — real recordings, not stock audio</dd></div>
      </dl>
    </div>
  </section>

  <!-- process -->
  <section class="band band--tight band-surface band--glow" aria-labelledby="process-title">
    <div class="shell">
      <div class="section-head"><div><p class="kicker">How it runs</p><h2 id="process-title">From first email to the moment itself</h2></div></div>
      <div class="svc-steps" data-reveal-group>
        <div class="card svc-step" data-reveal><h3>Conversation</h3><p>A short call or email exchange about the occasion, the room and what the music must do.</p></div>
        <div class="card svc-step" data-reveal><h3>Plan</h3><p>Pieces, moments and timing ranges — agreed in writing, with cues owned by named people.</p></div>
        <div class="card svc-step" data-reveal><h3>Performance or session</h3><p>Live at the occasion, or recorded takes with the setup documented as the guides describe.</p></div>
        <div class="card svc-step" data-reveal><h3>Delivery</h3><p>For productions: files, stems and notes packaged so the work continues without follow-up questions.</p></div>
      </div>
    </div>
  </section>

  <!-- honesty note + final CTA -->
  <section class="band" aria-labelledby="cta-title">
    <div class="shell">
      <div class="hub-note" style="max-width:60rem;padding:1.5rem;border-left:2px solid var(--ember-bright);background:var(--tint);border-radius:0 var(--r-sm) var(--r-sm) 0">
        <p style="color:var(--ink-soft)"><strong>The same honesty as the rest of this site.</strong> No invented client logos, no padded numbers. The method is public in the guides, the playing is audible on the musician's own site, and a first conversation costs nothing.</p>
      </div>
      <div style="margin-top:clamp(2rem,4vw,3rem);display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center">
        <h2 id="cta-title" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)">Start an enquiry</h2>
        <a class="btn btn--primary" href="mailto:info@matthiasramahi.de?subject=Enquiry%20%E2%80%94%20Auspicious%20Music">Start an enquiry</a>
        <a class="btn btn--quiet" href="/music-for-media/">Read the Media &amp; Events guides</a>
      </div>
    </div>
  </section>

</main>
</BaseLayout>
