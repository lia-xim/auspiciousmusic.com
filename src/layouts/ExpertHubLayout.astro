---
import BaseLayout from './BaseLayout.astro';

interface LinkAction { href: string; label: string; external?: boolean; }
interface Decision { title: string; text: string; href: string; label: string; }
interface Related { title: string; description: string; href: string; meta: string; }
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  kicker: string;
  intro: string;
  primary: LinkAction;
  secondary?: LinkAction;
  decisions: Decision[];
  decisionsTitle: string;
  decisionsIntro: string;
  related: Related[];
  relatedTitle: string;
  lang?: string;
}

const {
  title,
  description,
  canonicalPath,
  kicker,
  intro,
  primary,
  secondary,
  decisions,
  decisionsTitle,
  decisionsIntro,
  related,
  relatedTitle,
  lang = 'de',
} = Astro.props;
const hasEvidence = Astro.slots.has('evidence');
---
<BaseLayout title={`${title} — Auspicious Music`} description={description} canonicalPath={canonicalPath} lang={lang} headerOverDark={true}>
  <Fragment slot="head"><style is:global>
    @layer components {
      .expert-head {
        position: relative;
        overflow: clip;
        margin-top: calc(-1 * var(--header-h));
        padding-top: calc(var(--header-h) + clamp(2.5rem, 7vh, 5rem));
        padding-bottom: calc(var(--sheet-overlap) + clamp(3rem, 8vh, 6rem));
        background: var(--stage);
        color: var(--stage-text);
      }
      .expert-head::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--grain);
        background-size: 160px 160px;
        opacity: 0.05;
        pointer-events: none;
      }
      .expert-head__grid { position: relative; display: grid; gap: 3rem 6rem; align-items: center; }
      @media (min-width: 920px) { .expert-head__grid { grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.75fr); } }
      .expert-head .kicker, .expert-head .lede { color: var(--stage-muted); }
      .expert-head h1 { max-width: 15ch; margin-top: 1rem; color: var(--stage-text); font-size: 5rem; line-height: 0.98; letter-spacing: 0; }
      @media (max-width: 920px) { .expert-head h1 { font-size: 4rem; } }
      @media (max-width: 560px) { .expert-head h1 { font-size: 2.75rem; } }
      .expert-head .lede { max-width: 53ch; margin-top: 1.5rem; }
      .expert-head__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
      .expert-motif { min-block-size: 17rem; display: grid; place-items: center; border-block: 1px solid var(--stage-line); color: var(--stage-muted); }
      .expert-motif svg { inline-size: min(100%, 26rem); block-size: auto; }
      .expert-motif figcaption { margin-top: 0.9rem; font: 500 var(--t-meta)/1.5 var(--font-mono); color: var(--stage-muted); }
      .expert-motif--text { display: block; min-block-size: 0; padding-block: 1.25rem; }
      .expert-motif--text > p { color: var(--accent-on-dark); font: 600 var(--t-meta)/1.4 var(--font-mono); text-transform: uppercase; }
      .expert-motif--text ol { counter-reset: hero-facts; margin-top: .6rem; }
      .expert-motif--text li { counter-increment: hero-facts; display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: .7rem; padding-block: .75rem; border-top: 1px solid var(--stage-line); color: var(--stage-text); line-height: 1.45; }
      .expert-motif--text li::before { content: counter(hero-facts, decimal-leading-zero); color: var(--stage-muted); font: 500 var(--t-meta)/1.5 var(--font-mono); }
      .decision-list { counter-reset: decisions; border-top: 1px solid var(--line-strong); }
      .decision-list li { counter-increment: decisions; display: grid; grid-template-columns: 3rem minmax(0, 1fr) auto; gap: 1rem 1.5rem; align-items: start; padding-block: 1.4rem; border-bottom: 1px solid var(--line); }
      .decision-list li::before { content: counter(decisions, decimal-leading-zero); font: 500 var(--t-meta)/1.5 var(--font-mono); color: var(--ember); }
      .decision-list h3 { font-size: 1.2rem; }
      .decision-list p { max-width: 60ch; margin-top: 0.4rem; color: var(--ink-soft); }
      .decision-list a { align-self: center; white-space: nowrap; }
      @media (max-width: 680px) { .decision-list li { grid-template-columns: 2.25rem minmax(0, 1fr); } .decision-list a { grid-column: 2; justify-self: start; } }
      .expert-related { display: grid; border-top: 1px solid var(--line-strong); }
      .expert-related li { border-bottom: 1px solid var(--line); }
      .expert-related a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem 2rem; padding-block: 1.25rem; text-decoration: none; }
      .expert-related p { max-width: 62ch; margin-top: 0.35rem; color: var(--muted); }
      .expert-related span { font: 500 var(--t-meta)/1.5 var(--font-mono); color: var(--muted); white-space: nowrap; }
      @media (max-width: 600px) { .expert-related a { grid-template-columns: 1fr; } }
    }
  </style></Fragment>
  <main id="content">
    <section class="expert-head" data-stage-scene aria-labelledby="expert-title">
      <div class="shell expert-head__grid">
        <div>
          <p class="kicker">{kicker}</p>
          <h1 id="expert-title">{title}</h1>
          <p class="lede">{intro}</p>
          <div class="expert-head__actions">
            <a class="btn btn--primary" href={primary.href} rel={primary.external ? 'noopener external' : undefined}>{primary.label}</a>
            {secondary && <a class="btn btn--quiet" href={secondary.href} rel={secondary.external ? 'noopener external' : undefined}>{secondary.label}</a>}
          </div>
        </div>
        <slot name="motif" />
      </div>
    </section>
    <section class="band sheet-lift band--glow" aria-labelledby="decisions-title">
      <div class="shell">
        <div class="section-head"><h2 id="decisions-title">{decisionsTitle}</h2><p>{decisionsIntro}</p></div>
        <ol class="decision-list">
          {decisions.map((decision) => <li><div><h3>{decision.title}</h3><p>{decision.text}</p></div><a class="link" href={decision.href}>{decision.label} →</a></li>)}
        </ol>
      </div>
    </section>
    {hasEvidence && <section class="band"><div class="shell"><slot name="evidence" /></div></section>}
    <section class="band band-surface" aria-labelledby="related-title">
      <div class="shell">
        <div class="section-head"><h2 id="related-title">{relatedTitle}</h2></div>
        <ul class="expert-related">{related.map((item) => <li><a href={item.href}><div><h3>{item.title}</h3><p>{item.description}</p></div><span>{item.meta}</span></a></li>)}</ul>
      </div>
    </section>
  </main>
</BaseLayout>
