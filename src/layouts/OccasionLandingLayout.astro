---
import BaseLayout from './BaseLayout.astro';
import OccasionQuickPlanner from '../components/OccasionQuickPlanner.astro';
import OccasionLocations from '../components/OccasionLocations.astro';
import { youtubeSearchUrl, type OccasionProfile } from '../data/repertoire';

interface Props { profile: OccasionProfile; }
const { profile } = Astro.props;
const plannerHref = `/tools/eventmusik-planer/?anlass=${profile.slug}`;
const showQuickPlanner = profile.slug !== 'unterricht' && profile.pieces.length >= 3;
const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: profile.h1De,
      description: profile.seoDescriptionDe,
      inLanguage: 'de',
      mainEntity: { '@type': 'ItemList', name: `Musik für ${profile.labelDe}`, numberOfItems: profile.pieces.length },
    },
    {
      '@type': 'ItemList',
      name: `Repertoire für ${profile.labelDe}`,
      itemListElement: profile.pieces.map((piece, index) => ({ '@type': 'ListItem', position: index + 1, name: piece.title })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://www.auspiciousmusic.com/' },
        { '@type': 'ListItem', position: 2, name: 'Eventmusik', item: 'https://www.auspiciousmusic.com/eventmusik/' },
        { '@type': 'ListItem', position: 3, name: profile.labelDe },
      ],
    },
  ],
};
---

<BaseLayout
  title={profile.seoTitleDe}
  description={profile.seoDescriptionDe}
  canonicalPath={`/eventmusik/${profile.slug}/`}
  lang="de"
  headerOverDark={true}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    <style is:global>
      @layer components {
        .occasion-head { margin-top: calc(-1 * var(--header-h)); padding: calc(var(--header-h) + clamp(3.5rem, 9vh, 6.5rem)) 0 calc(var(--sheet-overlap) + clamp(3rem, 7vh, 5rem)); background: radial-gradient(ellipse at 50% 10%, #1b1d20 0%, #0d0f11 68%, #090a0c 100%); color: #f7f4ee; }
        .occasion-head__copy { max-width: 61rem; }
        .occasion-head h1 { max-width: 18ch; color: inherit; font-family: Georgia, 'Times New Roman', serif; font-size: 5rem; font-weight: 500; line-height: 1.02; letter-spacing: 0; text-wrap: balance; }
        @media (max-width: 900px) { .occasion-head h1 { font-size: 3.8rem; } }
        @media (max-width: 600px) { .occasion-head h1 { font-size: 2.8rem; } }
        @media (max-width: 360px) { .occasion-head h1 { font-size: 2.35rem; } }
        .occasion-head .lede { max-width: 68ch; margin-top: 1.3rem; color: #d3d5d7; font-size: clamp(1rem, .94rem + .25vw, 1.15rem); line-height: 1.7; }
        .occasion-head .kicker { margin-bottom: .8rem; color: #d7b66e; }
        .occasion-head__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.6rem; }
        .occasion-head .btn--quiet { color: #f7f4ee; border-color: #55595e; }
        .occasion-planner-band { position: relative; z-index: 2; padding-bottom: clamp(3.5rem, 7vw, 6rem); }
        .occasion-guide { display: grid; gap: 1.8rem 4.5rem; align-items: start; }
        @media (min-width: 840px) { .occasion-guide { grid-template-columns: minmax(17rem, .68fr) minmax(0, 1.32fr); } }
        .occasion-guide h2, .occasion-repertoire h2, .occasion-close h2 { font-family: Georgia, 'Times New Roman', serif; font-size: 3rem; font-weight: 500; letter-spacing: 0; }
        @media (max-width: 840px) { .occasion-guide h2, .occasion-repertoire h2, .occasion-close h2 { font-size: 2.2rem; } }
        .occasion-guide__body > p { max-width: 67ch; color: var(--ink-soft); font-size: 1.05rem; line-height: 1.75; }
        .occasion-flow { margin-top: 1.5rem; border-top: 1px solid var(--line-strong); }
        .occasion-flow li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; padding-block: 1.15rem; border-bottom: 1px solid var(--line); }
        .occasion-flow li::before { content: counter(list-item, decimal-leading-zero); padding-top: .15rem; color: #8f1d35; font-weight: 750; }
        .occasion-flow h3 { font-size: 1.05rem; letter-spacing: 0; }
        .occasion-flow p { max-width: 62ch; margin-top: .3rem; color: var(--muted); line-height: 1.55; }
        .occasion-repertoire { display: grid; gap: 2rem 4rem; }
        @media (min-width: 840px) { .occasion-repertoire { grid-template-columns: minmax(17rem, .7fr) minmax(0, 1.3fr); } }
        .occasion-repertoire header p { max-width: 42ch; margin-top: .8rem; color: var(--ink-soft); line-height: 1.65; }
        .piece-list { border-top: 1px solid var(--line-strong); }
        .piece-list li { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr) auto; gap: .75rem 1rem; align-items: center; min-height: 64px; border-bottom: 1px solid var(--line); }
        .piece-play { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border: 1px solid var(--ink); border-radius: 50%; color: var(--ink); text-decoration: none; }
        .piece-play:hover { background: var(--ink); color: #fff; }
        .piece-play svg { width: .85rem; height: .85rem; margin-left: .12rem; }
        .piece-list strong { font: 500 1.08rem/1.25 Georgia, 'Times New Roman', serif; }
        .piece-list span { max-width: 34ch; color: var(--muted); font-size: .8rem; text-align: right; }
        @media (max-width: 560px) { .piece-list li { grid-template-columns: 2.75rem 1fr; padding-block: .7rem; } .piece-play { width: 2.75rem; height: 2.75rem; } .piece-list span { grid-column: 2; text-align: left; } }
        .occasion-close { background: #17191d; color: #f2efe8; }
        .occasion-close__grid { display: grid; gap: 2rem 4rem; }
        @media (min-width: 840px) { .occasion-close__grid { grid-template-columns: minmax(0, 1fr) minmax(18rem, .72fr); } }
        .occasion-close h2 { color: inherit; }
        .occasion-close__intro { max-width: 62ch; margin-top: .8rem; color: #c5c8cc; line-height: 1.65; }
        .occasion-questions { margin-top: 1.6rem; border-top: 1px solid #45494e; }
        .occasion-questions li { padding: .85rem 0; border-bottom: 1px solid #34383d; color: #e1e2e3; }
        .occasion-questions li::before { content: 'Zu klären'; display: block; margin-bottom: .25rem; color: #d7b66e; font-size: .68rem; font-weight: 750; text-transform: uppercase; letter-spacing: .08em; }
        .occasion-handoff { align-self: center; padding: 1.5rem; border-left: 2px solid #a81f42; background: #202328; }
        .occasion-handoff p { color: #cdd0d2; line-height: 1.65; }
        .occasion-handoff .btn { width: 100%; justify-content: center; margin-top: 1.2rem; }
        .occasion-handoff__service { display: inline-block; margin-top: 1rem; color: #f2efe8; font-weight: 700; text-underline-offset: .2em; }
        .occasion-handoff__service:hover { color: #d7b66e; }
        .occasion-handoff small { display: block; margin-top: .8rem; color: #aeb2b6; line-height: 1.5; }
      }
    </style>
  </Fragment>

  <main id="content">
    <section class="occasion-head" data-stage-scene aria-labelledby="occasion-title">
      <div class="shell occasion-head__copy">
        <p class="kicker">Musikplanung für {profile.labelDe}</p>
        <h1 id="occasion-title">{profile.h1De}</h1>
        <p class="lede">{profile.introDe}</p>
        <div class="occasion-head__actions">
          {showQuickPlanner && <a class="btn btn--primary" href="#schnellauswahl">Drei Stücke finden</a>}
          <a class="btn btn--quiet" href="#repertoire">Repertoire anhören</a>
        </div>
      </div>
    </section>

    {showQuickPlanner && (
      <section class="band sheet-lift occasion-planner-band" id="schnellauswahl" aria-label={`Schnellauswahl für ${profile.labelDe}`}>
        <div class="shell"><OccasionQuickPlanner profile={profile} /></div>
      </section>
    )}

    <section class="band band-surface" aria-labelledby="ablauf-title">
      <div class="shell occasion-guide">
        <div><p class="kicker">Ablauf vor Titelauswahl</p><h2 id="ablauf-title">Was zuerst geklärt werden sollte</h2></div>
        <div class="occasion-guide__body">
          <p>{profile.planningDe}</p>
          <ol class="occasion-flow">
            {profile.moments.map((moment) => <li><div><h3>{moment.de}</h3><p>{moment.guidanceDe}</p></div></li>)}
          </ol>
        </div>
      </div>
    </section>

    {profile.slug !== 'unterricht' && <OccasionLocations profile={profile} />}

    <section class="band" id="repertoire" aria-labelledby="repertoire-title">
      <div class="shell occasion-repertoire">
        <header>
          <p class="kicker">Anhören und eingrenzen</p>
          <h2 id="repertoire-title">Repertoire für {profile.labelDe}</h2>
          <p>Die Links öffnen jeweils eine YouTube-Suche. Die genaue Fassung, Spielbarkeit und ein mögliches Arrangement werden erst in der persönlichen Abstimmung bestätigt.</p>
        </header>
        <ul class="piece-list">
          {profile.pieces.map((piece) => (
            <li>
              <a class="piece-play" href={youtubeSearchUrl(piece.title)} target="_blank" rel="noopener noreferrer external" aria-label={`${piece.title} auf YouTube suchen und anhören`} title="Auf YouTube suchen und anhören"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 5 8 5-8 5Z" fill="currentColor" /></svg></a>
              <strong>{piece.title}</strong>
              {piece.clarificationDe && <span>{piece.clarificationDe}</span>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band occasion-close" aria-labelledby="fragen-title">
      <div class="shell occasion-close__grid">
        <div>
          <h2 id="fragen-title">Diese Fragen gehören in die Abstimmung</h2>
          <p class="occasion-close__intro">Ein erster Musikplan darf unvollständig sein. Wichtig ist nur, dass die offenen Punkte sichtbar bleiben.</p>
          <ul class="occasion-questions">{profile.questionsDe.map((question) => <li>{question}</li>)}</ul>
        </div>
        <aside class="occasion-handoff">
          <p>Im vollständigen Planer ergänzt ihr Ort, Rahmen und Besetzung. Danach lässt sich der Plan kopieren und Kim-Maries Kontaktseite direkt öffnen.</p>
          <a class="btn btn--primary" href={plannerHref}>Plan für {profile.labelDe} erstellen</a>
          <a class="occasion-handoff__service" href={profile.expertServiceUrl} rel="noopener external">{profile.expertServiceLabelDe}</a>
          <small>Der Planer bestätigt weder Termin noch Preis. Kim-Marie prüft Anfrage, Fassung und Verfügbarkeit persönlich. Auspicious Music und die verlinkte Angebotsseite werden im Projektportfolio desselben Herausgebers betreut; der Link ist keine unabhängige Empfehlung.</small>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
