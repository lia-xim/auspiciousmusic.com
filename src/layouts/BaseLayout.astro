---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteStrategy } from '../data/site-strategy';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  lang?: string;
  noindex?: boolean;
  loadStringField?: boolean;
  contentType?: 'website' | 'article';
  published?: string;
  updated?: string;
  section?: string;
  headerOverDark?: boolean;
  alternatePath?: string;
  languagePath?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  lang = 'de',
  noindex = false,
  loadStringField = false,
  contentType = 'website',
  published,
  updated,
  section,
  headerOverDark = false,
  alternatePath,
  languagePath,
} = Astro.props;

const siteIndexable = import.meta.env.SITE_INDEXABLE === 'true';
const robots = siteIndexable && !noindex ? 'index,follow,max-image-preview:large' : 'noindex,nofollow,noarchive';
const site = Astro.site ?? new URL('https://www.auspiciousmusic.com/');
const canonical = new URL(canonicalPath, site);
const alternate = alternatePath ? new URL(alternatePath, site) : undefined;
const alternateLang = lang === 'de' ? 'en' : 'de';
const xDefault = alternate ? (lang === 'de' ? canonical : alternate) : undefined;
const image = new URL('/assets/hero-portrait-928.jpg', site);
const locale = lang === 'de' ? 'de_DE' : 'en_US';
const socialImageAlt = lang === 'de'
  ? 'Redaktionelle Auspicious-Music-Illustration mit Metallblock und gespannter Saite'
  : 'Auspicious Music editorial illustration of a metal block and a tensioned string';
const publisherId = new URL('/authors/#matthias-ramahi', site).href;
const expertId = new URL('/authors/#kim-marie-borger', site).href;
const identitySchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': publisherId,
      name: siteStrategy.publisher.name,
      url: new URL('/authors/', site).href,
      email: 'info@matthiasramahi.de',
      telephone: '+49 176 42 44 98 58',
      sameAs: [siteStrategy.publisher.url],
    },
    {
      '@type': 'Person',
      '@id': expertId,
      name: siteStrategy.expert.name,
      jobTitle: siteStrategy.expert.role,
      url: siteStrategy.expert.url,
      sameAs: [siteStrategy.expert.url],
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', site).href,
      name: `${siteStrategy.name} — ${siteStrategy.subtitle}`,
      url: site.href,
      inLanguage: ['de', 'en'],
      publisher: { '@id': publisherId },
      about: { '@id': expertId },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Matthias Ramahi" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {alternate && <link rel="alternate" hreflang={lang} href={canonical} />}
    {alternate && <link rel="alternate" hreflang={alternateLang} href={alternate} />}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="alternate" type="application/rss+xml" title="Auspicious Music RSS" href="/rss.xml" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/inter.css" />
    <link rel="stylesheet" href="/assets/system.css" />
    <link rel="stylesheet" href="/assets/strategy.css" />
    <meta name="theme-color" content={headerOverDark ? '#0d0f16' : '#f1eee6'} />
    <meta property="og:type" content={contentType} />
    <meta property="og:site_name" content="Auspicious Music" />
    <meta property="og:locale" content={locale} />
    {alternate && <meta property="og:locale:alternate" content={lang === 'de' ? 'en_US' : 'de_DE'} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="928" />
    <meta property="og:image:height" content="742" />
    <meta property="og:image:alt" content={socialImageAlt} />
    {contentType === 'article' && published && <meta property="article:published_time" content={published} />}
    {contentType === 'article' && updated && <meta property="article:modified_time" content={updated} />}
    {contentType === 'article' && section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(identitySchema)} />
    <slot name="head" />
  </head>
  <body>
    <SiteHeader currentPath={Astro.url.pathname} overDark={headerOverDark} lang={lang === 'en' ? 'en' : 'de'} alternatePath={alternatePath} languagePath={languagePath} />
    <slot />
    <SiteFooter lang={lang === 'en' ? 'en' : 'de'} />
    <script is:inline src="/assets/motion.js" defer></script>
    {loadStringField && <script is:inline src="/assets/string.js" defer></script>}
    <slot name="scripts" />
  </body>
</html>
