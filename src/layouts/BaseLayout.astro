---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  lang?: string;
  noindex?: boolean;
  loadStringField?: boolean;
  contentType?: 'website' | 'article';
  published?: string;
  updated?: string;
  section?: string;
  /** Page opens on the ink stage: the header starts transparent over it. */
  headerOverDark?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  lang = 'en',
  noindex = false,
  loadStringField = false,
  contentType = 'website',
  published,
  updated,
  section,
  headerOverDark = false,
} = Astro.props;

const siteIndexable = import.meta.env.SITE_INDEXABLE === 'true';
const robots = siteIndexable && !noindex ? 'index,follow,max-image-preview:large' : 'noindex,nofollow,noarchive';
const site = Astro.site ?? new URL('https://www.auspiciousmusic.com/');
const canonical = new URL(canonicalPath, site);
const image = new URL('/assets/hero-portrait.png', site);
const locale = lang === 'de' ? 'de_DE' : 'en_US';
const authorId = new URL('/authors/#matthias-ramahi', site).href;
const identitySchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': authorId,
      name: 'Matthias Ramahi',
      url: new URL('/authors/', site).href,
      email: 'info@matthiasramahi.de',
      telephone: '+49 176 42 44 98 58',
      sameAs: ['https://matthiasramahi.de/'],
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', site).href,
      name: 'Auspicious Music',
      url: site.href,
      inLanguage: 'en',
      publisher: { '@id': authorId },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Matthias Ramahi" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Auspicious Music RSS" href="/rss.xml" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/inter.css" />
    <link rel="stylesheet" href="/assets/system.css" />
    <meta name="theme-color" content={headerOverDark ? '#0d0f16' : '#f1eee6'} />
    <meta property="og:type" content={contentType} />
    <meta property="og:site_name" content="Auspicious Music" />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="928" />
    <meta property="og:image:height" content="1152" />
    <meta property="og:image:alt" content="Auspicious Music editorial illustration of a metal block and a tensioned string" />
    {contentType === 'article' && published && <meta property="article:published_time" content={published} />}
    {contentType === 'article' && updated && <meta property="article:modified_time" content={updated} />}
    {contentType === 'article' && section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="Auspicious Music editorial illustration of a metal block and a tensioned string" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(identitySchema)} />
    <slot name="head" />
  </head>
  <body>
    <SiteHeader currentPath={Astro.url.pathname} overDark={headerOverDark} />
    <slot />
    <SiteFooter />
    <script is:inline src="/assets/motion.js" defer></script>
    {loadStringField && <script is:inline src="/assets/string.js" defer></script>}
    <slot name="scripts" />
  </body>
</html>
