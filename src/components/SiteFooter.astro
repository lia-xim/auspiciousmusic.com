---
interface Props { lang?: 'de' | 'en'; }
const { lang = 'de' } = Astro.props;
const de = lang === 'de';
const homePath = de ? '/' : '/en/';
const columns = de ? [
  { title: 'Anlässe', links: [['Hochzeit', '/eventmusik/hochzeit/'], ['Sektempfang', '/eventmusik/sektempfang/'], ['Trauerfeier', '/eventmusik/trauerfeier/'], ['Dinner', '/eventmusik/dinner/'], ['Firmenevent', '/eventmusik/firmenevent/'], ['Geburtstag', '/eventmusik/geburtstag/']] },
  { title: 'Planen', links: [['Eventmusik-Planer', '/tools/eventmusik-planer/'], ['Repertoire nach Anlass', '/repertoire/'], ['Wunschstück prüfen', '/tools/wunschstueck-check/']] },
  { title: 'Fachthemen', links: [['Viola', '/viola/'], ['Aufnahme', '/recording/'], ['Live oder Sample-Bibliothek?', '/sound-design/when-to-record-strings-instead-of-using-a-library/']] },
  { title: 'Über Auspicious Music', links: [['Aufgabe und Rollen', '/about/'], ['Fachperson und Herausgeber', '/authors/'], ['Redaktionelle Regeln', '/about/editorial-policy/'], ['Geschichte und Neustart', '/about/history-and-relaunch/']] },
  { title: 'Rechtliches', links: [['Impressum', '/legal/'], ['Datenschutz', '/privacy/'], ['Barrierefreiheit', '/accessibility/'], ['Sitemap', '/sitemap/']] },
] : [
  { title: 'Plan an event', links: [['English event-music planner', '/en/tools/event-music-planner/'], ['English overview', '/en/']] },
  { title: 'Music planning', links: [['Wedding ceremony guide', '/music-for-media/planning-live-viola-for-a-wedding-ceremony/'], ['Viola and strings', '/viola/'], ['Recording strings', '/recording/']] },
  { title: 'Publication', links: [['About this project', '/about/'], ['History and ownership', '/about/history-and-relaunch/']] },
  { title: 'Legal', links: [['Legal notice (German)', '/legal/'], ['Privacy (German)', '/privacy/'], ['Accessibility (German)', '/accessibility/']] },
];
const description = de
  ? 'Unabhängige Entscheidungshilfe für Viola, Eventmusik, Repertoire und Aufnahme. Kim-Marie Borger ist die heutige musikalische Fachperson.'
  : 'A focused English entry into the Auspicious Music event-planning and strings guides.';
const boundary = de
  ? 'Neues redaktionelles Projekt. Keine Verbindung zum früheren Betreiber.'
  : 'New editorial project. No connection to the former operator.';
const brandSubtitle = de ? 'Viola & Streicher' : 'Viola & Strings Lab';
---
<footer class="site-footer" data-od-id="footer">
  <div class="shell">
    <div class="footer-grid">
      <div><a class="brand" href={homePath}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 12C5.7 4 8.3 4 12 12C15.7 20 18.3 20 22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M2 12C5.7 16 8.3 16 12 12C15.7 8 18.3 8 22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".42"/></svg><span>Auspicious Music<small class="brand__sub">{brandSubtitle}</small></span></a><p style="font-size:var(--t-ui-sm);color:var(--stage-muted);margin-top:1rem;max-width:32ch;line-height:1.6">{description}</p></div>
      {columns.map((column) => <div><h2>{column.title}</h2><ul>{column.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul></div>)}
    </div>
    <div class="footer-base"><span>© 2026 Matthias Ramahi · Auspicious Music</span><span>{boundary}</span></div>
  </div>
</footer>
