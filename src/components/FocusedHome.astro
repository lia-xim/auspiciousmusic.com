---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveEditorialImage from './ResponsiveEditorialImage.astro';
import { youtubeSearchUrl } from '../data/repertoire';

interface Props { lang: 'de' | 'en'; }
const { lang } = Astro.props;
const de = lang === 'de';
const planner = de ? '/tools/eventmusik-planer/' : '/en/tools/event-music-planner/';
const copy = de ? {
  title: 'Auspicious Music — Musik für Trauung und Event planen',
  description: 'Ein kostenloser Musikplaner für Trauung, Trauerfeier und Event: Anlass und Wirkung wählen, passende Repertoire-Ideen erhalten und mit Kim-Marie abstimmen.',
  h1: 'Musik, die zu eurem Moment passt.',
  intro: 'Persönliche Liedempfehlungen für eure Zeremonie oder euer Event.',
  primary: 'Musikplan erstellen', occasionLabel: 'Wofür plant ihr Musik?',
  occasions: [['Hochzeit', 'hochzeit'], ['Freie Trauung', 'hochzeit'], ['Kirchliche Trauung', 'hochzeit'], ['Sektempfang', 'sektempfang'], ['Trauerfeier', 'trauerfeier'], ['Konzert & Event', 'firmenevent']],
  howLabel: 'In 3 Schritten zu eurer Musik',
  steps: [['Anlass wählen', 'Wählt den Anlass und die gewünschten Momente.'], ['Stimmung & Rahmen', 'Gebt Wirkung, Ort und musikalische Rolle an.'], ['Empfehlungen erhalten', 'Drei Titel werden konkreten Momenten zugeordnet.']],
  exampleTitle: 'So sehen Empfehlungen aus', exampleNote: 'Beispiel für eine Hochzeit · der Planer berechnet eure persönliche Auswahl.', listen: 'Auf YouTube suchen und anhören', moment: 'Passender Moment', why: 'Warum passt es?',
  examples: [
    ['A Thousand Years', 'Warm und persönlich – gibt einem feierlichen Einzug Ruhe und Raum.', 'Einzug'],
    ['Canon in D', 'Klar und festlich – trägt einen bewusst gesetzten Zeremonienmoment.', 'Ringtausch oder Unterschrift'],
    ['Perfect', 'Modern und nahbar – unterstützt einen leichten, gemeinsamen Auszug.', 'Auszug'],
  ],
  focusLabel: 'Planung und Buchung', focusTitle: 'Hier vorbereiten. Mit Kim-Marie persönlich abstimmen.',
  focusText: 'Auspicious Music hilft, Musikmomente zu erkennen und passende Titel einzugrenzen. Verfügbarkeit, konkrete Fassung, Besetzung und Preis bestätigt Kim-Marie Borger auf ihrer eigenen Website.',
  focusAction: 'Kim-Maries Rolle im Projekt', pathsTitle: 'Weiter planen',
  paths: [['Hochzeitsmusik planen', 'Einzug, Ringtausch und Auszug in eine klare Reihenfolge bringen.', '/eventmusik/hochzeit/'], ['Musik für eine Trauerfeier', 'Persönliche Stücke behutsam mit Worten und Abschied verbinden.', '/eventmusik/trauerfeier/'], ['Repertoire nach Anlass', 'Titel nach ihrer Aufgabe im Ablauf erkunden.', '/repertoire/'], ['Viola verstehen', 'Klang, Rolle und Grenzen der Viola einordnen.', '/viola/']],
  disclosure: 'Kim-Marie Borger ist die heutige musikalische Fachperson dieses Projekts. Matthias Ramahi ist Herausgeber. Auspicious Music ist ein neues redaktionelles Projekt und keine Fortsetzung des früheren Betreibers.',
} : {
  title: 'Auspicious Music — Plan music for ceremonies and events',
  description: 'A free music planner for ceremonies and events: choose the occasion and desired effect, receive repertoire suggestions and prepare the conversation with Kim-Marie.',
  h1: 'Music that fits your moment.', intro: 'Personal song suggestions for your ceremony or event.',
  primary: 'Create a music plan', occasionLabel: 'What are you planning music for?',
  occasions: [['Wedding', 'hochzeit'], ['Independent ceremony', 'hochzeit'], ['Church ceremony', 'hochzeit'], ['Drinks reception', 'sektempfang'], ['Funeral / memorial', 'trauerfeier'], ['Concert & event', 'firmenevent']],
  howLabel: 'Your music in 3 steps',
  steps: [['Choose the occasion', 'Select the event and the moments that need music.'], ['Set mood & context', 'Add character, place and the role of the music.'], ['Receive suggestions', 'Three titles are matched to specific moments.']],
  exampleTitle: 'What a recommendation looks like', exampleNote: 'Wedding example · the planner calculates your personal selection.', listen: 'Search and listen on YouTube', moment: 'Suitable moment', why: 'Why it fits',
  examples: [
    ['A Thousand Years', 'Warm and personal, leaving calm space for a ceremonial entrance.', 'Entrance'],
    ['Canon in D', 'Clear and formal, supporting a deliberately placed ceremony moment.', 'Rings, vows or signing'],
    ['Perfect', 'Modern and approachable, supporting a light shared exit.', 'Exit'],
  ],
  focusLabel: 'Planning and booking', focusTitle: 'Prepare here. Confirm personally with Kim-Marie.',
  focusText: 'Auspicious Music helps identify musical moments and narrow down suitable titles. Kim-Marie Borger confirms availability, exact version, line-up and price on her own website.',
  focusAction: 'Kim-Marie’s role in the project', pathsTitle: 'Continue planning',
  paths: [['Event-music planner', 'Build suggestions around a real occasion and running order.', '/en/tools/event-music-planner/'], ['Wedding ceremony guide', 'Plan cues, flexible timings and practical conditions.', '/music-for-media/planning-live-viola-for-a-wedding-ceremony/'], ['Viola and strings', 'Understand register, role and practical limits.', '/viola/'], ['Recording strings', 'Prepare room, placement and repeatable decisions.', '/recording/']],
  disclosure: 'Kim-Marie Borger is the current musical expert for this project. Matthias Ramahi is the publisher. Auspicious Music is a new editorial project, not a continuation of the former operator.',
};
---

<BaseLayout title={copy.title} description={copy.description} canonicalPath={de ? '/' : '/en/'} lang={lang} headerOverDark={true} loadStringField={true} alternatePath={de ? '/en/' : '/'}>
  <Fragment slot="head">
    <style is:global>
      @layer components {
        .focus-home { background: #fff; color: #17191f; }
        .focus-hero { position: relative; min-height: clamp(31rem, 54svh, 35rem); margin-top: calc(-1 * var(--header-h)); padding-top: var(--header-h); overflow: hidden; background: radial-gradient(ellipse at 50% 18%, #181a1d 0%, #0d0f11 58%, #090a0c 100%); color: #f7f4ee; }
        .focus-hero::before { content: ''; position: absolute; inset: 0; background: var(--grain); background-size: 160px 160px; opacity: .035; pointer-events: none; }
        .focus-hero__string { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; --string-line: #d7b66e; --string-node: #a81f42; opacity: .72; }
        .focus-hero__inner { position: relative; z-index: 2; display: grid; grid-template-rows: 1fr auto; min-height: clamp(31rem, 54svh, 35rem); box-sizing: border-box; padding-block: clamp(4.5rem, 7vh, 5.5rem) .8rem; pointer-events: none; }
        .focus-hero__copy { width: min(48rem, 100%); margin: auto; text-align: center; pointer-events: auto; }
        .focus-hero h1 { max-width: 15ch; margin-inline: auto; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(3rem, 1.8rem + 3vw, 4.7rem); font-weight: 500; line-height: 1.04; letter-spacing: 0; text-wrap: balance; }
        .focus-hero__flourish { display: flex; justify-content: center; align-items: center; gap: .85rem; margin: 1rem auto; color: #d7b66e; }
        .focus-hero__flourish::before, .focus-hero__flourish::after { content: ''; width: clamp(3rem, 8vw, 7rem); height: 1px; background: currentColor; opacity: .75; }
        .focus-hero__pluck { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid currentColor; border-radius: 50%; color: inherit; }
        .focus-hero__pluck svg { width: 1.05rem; height: 1.05rem; }
        .focus-hero__intro { max-width: 48rem; margin-inline: auto; color: #e1e0dc; font-size: clamp(1rem, .94rem + .22vw, 1.18rem); line-height: 1.55; }
        .focus-hero__actions { margin-top: 1.5rem; }
        .focus-hero__actions .btn { min-width: min(22rem, 100%); min-height: 58px; justify-content: center; border-radius: 2px; font-size: 1rem; }
        .occasion-start { width: 100%; max-width: 76rem; margin: clamp(2.4rem, 6vh, 4rem) auto 0; pointer-events: auto; }
        .occasion-start > p { color: #d7b66e; font: 700 .77rem/1.2 var(--font-sans); text-transform: uppercase; letter-spacing: .12em; text-align: center; }
        .occasion-start ul { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin-top: .65rem; }
        .occasion-start a { position: relative; display: grid; justify-items: center; gap: .5rem; min-height: 66px; padding: .65rem .35rem .8rem; color: #e8e6e1; font-size: .86rem; text-align: center; text-decoration: none; }
        .occasion-start a::before { content: attr(data-number); color: #d7b66e; font: 500 1rem/1 Georgia, serif; }
        .occasion-start a::after { content: ''; position: absolute; inset: auto .7rem 0; height: 2px; background: #a81f42; transform: scaleX(0); transition: transform 180ms ease; }
        .occasion-start a:hover::after, .occasion-start a:focus-visible::after { transform: scaleX(1); }
        .focus-how { padding-block: 1.25rem; background: #fff; border-bottom: 1px solid #dadbdc; }
        .focus-how__label { color: #765a1f; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; text-align: center; }
        .focus-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 76rem; margin: 1.15rem auto 0; }
        .focus-step { position: relative; display: grid; grid-template-columns: 2.65rem 1fr; gap: .8rem; align-items: start; padding-inline: clamp(.7rem, 2.5vw, 2rem); }
        .focus-step + .focus-step { border-left: 1px solid #d6d7d8; }
        .focus-step__n { display: grid; place-items: center; width: 2.3rem; height: 2.3rem; border-radius: 50%; background: #1b1d20; color: #fff; font-weight: 700; }
        .focus-step h3 { font-size: .98rem; letter-spacing: 0; }
        .focus-step p { margin-top: .2rem; color: #5f646a; font-size: .83rem; line-height: 1.45; }
        .focus-example { padding-block: clamp(2.2rem, 5vw, 4.2rem); background: #fff; }
        .focus-example__head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #d5d6d7; }
        .focus-example h2 { color: #8f1d35; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 1.6rem + 1vw, 2.8rem); font-weight: 500; letter-spacing: 0; }
        .focus-example__head p { color: #646a70; font-size: .84rem; }
        .music-row { display: grid; grid-template-columns: 2.5rem 3rem minmax(12rem, .95fr) minmax(15rem, 1.2fr) minmax(10rem, .7fr); gap: 1rem; align-items: center; min-height: 76px; border-bottom: 1px solid #dedfe0; }
        .music-row__number { color: #8f1d35; font-weight: 700; font-variant-numeric: tabular-nums; }
        .music-row__play { display: grid; place-items: center; width: 2.35rem; height: 2.35rem; border: 1px solid #33373b; border-radius: 50%; color: #17191f; text-decoration: none; }
        .music-row__play:hover { background: #17191f; color: #fff; }
        .music-row__play svg { width: .9rem; height: .9rem; margin-left: .12rem; }
        .music-row__title { font: 500 clamp(1.25rem, 1rem + .55vw, 1.75rem)/1.2 Georgia, 'Times New Roman', serif; }
        .music-row__detail small { display: block; margin-bottom: .25rem; color: #765a1f; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .09em; }
        .music-row__detail span { color: #3f4449; font-size: .84rem; line-height: 1.4; }
        .focus-band { padding-block: clamp(3.5rem, 7vw, 6rem); }
        .focus-split { display: grid; gap: 2.5rem 5rem; align-items: center; }
        @media (min-width: 900px) { .focus-split { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); } }
        .focus-split__media { overflow: hidden; border-radius: 2px; border: 1px solid #d0d4d8; }
        .focus-split__media img { aspect-ratio: 16/10; object-fit: cover; }
        .focus-split h2 { margin-top: .7rem; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 1.5rem + 1.7vw, 3.25rem); font-weight: 500; letter-spacing: 0; }
        .focus-split p:not(.kicker) { margin-top: 1rem; color: #525960; line-height: 1.7; }
        .focus-split a { display: inline-block; margin-top: 1.2rem; color: #8f1d35; font-weight: 700; }
        .focus-paths { background: #f4f5f6; border-block: 1px solid #d9dce0; }
        .focus-paths h2 { font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 1.6rem + 1.2vw, 2.8rem); font-weight: 500; letter-spacing: 0; }
        .focus-path-list { margin-top: 1.5rem; border-top: 1px solid #bfc4c9; }
        .focus-path-list a { display: grid; gap: .4rem 2rem; padding: 1.2rem 0; border-bottom: 1px solid #d9dce0; text-decoration: none; }
        @media (min-width: 740px) { .focus-path-list a { grid-template-columns: minmax(14rem, .65fr) minmax(0, 1fr) auto; align-items: center; } }
        .focus-path-list h3 { font-size: 1.05rem; letter-spacing: 0; }
        .focus-path-list p { color: #60676e; font-size: .91rem; }
        .focus-path-list span { color: #8f1d35; font-weight: 700; }
        .focus-disclosure { background: #0d0f11; color: #c4c7cd; padding-block: 1.6rem; }
        .focus-disclosure p { max-width: 78rem; font-size: .82rem; line-height: 1.55; }
        @media (max-width: 800px) {
          .occasion-start ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
          .focus-steps { grid-template-columns: 1fr; gap: 1rem; }
          .focus-step + .focus-step { border-left: 0; }
          .music-row { grid-template-columns: 2rem 2.6rem 1fr; gap: .7rem; padding-block: .85rem; }
          .music-row__detail { grid-column: 3; }
          .focus-example__head { display: block; }
          .focus-example__head p { margin-top: .45rem; }
        }
        @media (max-width: 520px) {
          .focus-hero { min-height: 43rem; }
          .focus-hero__inner { min-height: 43rem; padding-top: 5.5rem; }
          .focus-hero h1 { font-size: clamp(2.75rem, 13vw, 4rem); }
          .occasion-start { margin-top: 2.3rem; }
          .occasion-start a { min-height: 58px; font-size: .76rem; }
          .occasion-start a::before { font-size: .8rem; }
          .focus-how { padding-block: 1.6rem; }
          .music-row__detail span { font-size: .79rem; }
        }
      }
    </style>
  </Fragment>

  <main id="content" class="focus-home">
    <section class="focus-hero hero" data-stage-scene aria-labelledby="focus-home-title">
      <canvas class="focus-hero__string" data-string aria-hidden="true"></canvas>
      <div class="shell focus-hero__inner">
        <div class="focus-hero__copy">
          <h1 id="focus-home-title">{copy.h1}</h1>
          <div class="focus-hero__flourish"><button class="focus-hero__pluck" type="button" data-string-pluck aria-label={de ? 'Saiten anspielen' : 'Play the strings'} title={de ? 'Saiten anspielen' : 'Play the strings'}><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M2 10c3-6 5-6 8 0s5 6 8 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button></div>
          <p class="focus-hero__intro">{copy.intro}</p>
          <div class="focus-hero__actions"><a class="btn btn--primary" href={planner}>{copy.primary}<span aria-hidden="true">→</span></a></div>
        </div>
        <nav class="occasion-start" aria-label={copy.occasionLabel}><p>{copy.occasionLabel}</p><ul>{copy.occasions.map(([label, slug], index) => <li><a data-number={String(index + 1).padStart(2, '0')} href={`${planner}?${de ? 'anlass' : 'occasion'}=${slug}`}>{label}</a></li>)}</ul></nav>
      </div>
    </section>

    <section class="focus-how" aria-labelledby="focus-how-title"><div class="shell"><h2 class="focus-how__label" id="focus-how-title">{copy.howLabel}</h2><ol class="focus-steps">{copy.steps.map(([title, text], index) => <li class="focus-step"><span class="focus-step__n">{index + 1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div></section>

    <section class="focus-example" aria-labelledby="focus-example-title"><div class="shell"><header class="focus-example__head"><h2 id="focus-example-title">{copy.exampleTitle}</h2><p>{copy.exampleNote}</p></header><ol>{copy.examples.map(([title, reason, moment], index) => <li class="music-row"><span class="music-row__number">{String(index + 1).padStart(2, '0')}</span><a class="music-row__play" href={youtubeSearchUrl(title)} target="_blank" rel="noopener noreferrer external" aria-label={`${title}: ${copy.listen}`} title={copy.listen}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 5 8 5-8 5Z" fill="currentColor"/></svg></a><span class="music-row__title">{title}</span><span class="music-row__detail"><small>{copy.why}</small><span>{reason}</span></span><span class="music-row__detail"><small>{copy.moment}</small><span>{moment}</span></span></li>)}</ol></div></section>

    <section class="focus-band"><div class="shell focus-split"><figure class="focus-split__media"><ResponsiveEditorialImage asset="hero-portrait" sizes="(min-width: 900px) 42vw, 100vw" alt={de ? 'Redaktionelle Darstellung einer gespannten Saite auf einem Metallsteg' : 'Editorial image of a tensioned string on a metal bridge'} /></figure><div><p class="kicker">{copy.focusLabel}</p><h2>{copy.focusTitle}</h2><p>{copy.focusText}</p><a href="/about/">{copy.focusAction} →</a></div></div></section>
    <section class="focus-band focus-paths"><div class="shell"><h2>{copy.pathsTitle}</h2><ul class="focus-path-list">{copy.paths.map(([title, text, href]) => <li><a href={href}><h3>{title}</h3><p>{text}</p><span aria-hidden="true">→</span></a></li>)}</ul></div></section>
    <aside class="focus-disclosure"><div class="shell"><p>{copy.disclosure}</p></div></aside>
  </main>
</BaseLayout>
