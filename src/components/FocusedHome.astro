---
import BaseLayout from '../layouts/BaseLayout.astro';
import { youtubeSearchUrl } from '../data/repertoire';

interface Props { lang: 'de' | 'en'; }
const { lang } = Astro.props;
const de = lang === 'de';
const planner = de ? '/tools/eventmusik-planer/' : '/en/tools/event-music-planner/';
const copy = de ? {
  title: 'Musik für Hochzeit, Trauerfeier & Event planen | Auspicious Music',
  description: 'Musik für Hochzeit, Trauerfeier und Event auswählen: Anlass und Spielmomente wählen, drei Stücke anhören und einen Ablauf für die Abstimmung vorbereiten.',
  h1: 'Musik, die zu eurem Moment passt.',
  intro: 'Wählt den Anlass und die Stellen, an denen Musik wirklich gebraucht wird. Ihr bekommt drei passende Stücke und einen Ablauf für die persönliche Abstimmung.',
  primary: 'Musikplan erstellen', occasionLabel: 'Wofür plant ihr Musik?',
  occasions: [['Hochzeit', 'hochzeit'], ['Freie Trauung', 'hochzeit'], ['Kirchliche Trauung', 'hochzeit'], ['Sektempfang', 'sektempfang'], ['Trauerfeier', 'trauerfeier'], ['Konzert & Event', 'firmenevent']],
  howLabel: 'Drei kurze Entscheidungen',
  steps: [['Anlass wählen', 'Hochzeit, Trauerfeier, Empfang oder ein anderes Event.'], ['Momente festlegen', 'Nur die Stellen auswählen, an denen Musik Platz hat.'], ['Stücke anhören', 'Drei Titel werden dem Ablauf zugeordnet.']],
  exampleTitle: 'So sieht eine Auswahl aus', exampleNote: 'Beispiel für eine Trauung · im Planer entsteht eure eigene Auswahl.', listen: 'Auf YouTube suchen und anhören', moment: 'Im Ablauf', why: 'Einordnung',
  examples: [
    ['A Thousand Years', 'Warm und persönlich; lässt beim Einzug Zeit für den Weg.', 'Einzug'],
    ['Canon in D', 'Klar und feierlich; die Fassung kann an die Dauer des Moments angepasst werden.', 'Ringtausch oder Unterschrift'],
    ['Perfect', 'Modern und leicht; markiert den Wechsel von der Zeremonie zum Feiern.', 'Auszug'],
  ],
  outcomeLabel: 'Was der Planer erledigt', outcomeTitle: 'Eine kleine Auswahl, die man besprechen kann.', outcomeIntro: 'Für den ersten Schritt braucht ihr weder ein festes Datum noch einen vollständig geplanten Tagesablauf.',
  outcomes: [['Drei Stücke', 'Nicht das ganze Repertoire, sondern drei Vorschläge für die gewählten Momente.'], ['Ein Ablauf', 'Die Stücke stehen dort, wo sie eingesetzt werden könnten.'], ['Offene Punkte', 'Was noch mit Location und Musikerin geklärt werden muss, bleibt im Plan.']],
  guidesLabel: 'Direkt mit dem Anlass starten', guidesTitle: 'Jeder Ablauf braucht eine andere Auswahl.', guidesIntro: 'Auf jeder Anlassseite steht die passende Schnellauswahl direkt oben. Hochzeitsmusik wird nicht mit Trauermusik oder Dinner-Repertoire vermischt.',
  guides: [['Hochzeitsmusik', 'Musik für Einzug, Ringtausch, Unterschrift und Auszug auswählen.', '/eventmusik/hochzeit/'], ['Musik zum Sektempfang', 'Leichte Stücke für Ankommen, Gratulationen und Gespräche finden.', '/eventmusik/sektempfang/'], ['Trauermusik', 'Wenige persönliche Stücke für Beginn, Erinnerung und Abschied ordnen.', '/eventmusik/trauerfeier/'], ['Dinnermusik', 'Musik zwischen Ankommen, Gängen, Reden und Ausklang platzieren.', '/eventmusik/dinner/'], ['Musik fürs Firmenevent', 'Empfang, Hintergrund und hervorgehobenen Programmpunkt trennen.', '/eventmusik/firmenevent/'], ['Musik zum Geburtstag', 'Überraschung, musikalisches Geschenk oder Empfang vorbereiten.', '/eventmusik/geburtstag/']],
  handoffTitle: 'Der Plan ist die Vorbereitung, nicht die Buchung.',
  handoffText: 'Kim-Marie Borger prüft anschließend persönlich, ob Termin, Titel, Fassung und Besetzung passen. Aus dem Planer führt ein direkter Weg zu ihrer Kontaktseite.',
  handoffAction: 'Musikplan beginnen',
  disclosure: 'Kim-Marie Borger ist die heutige musikalische Fachperson dieses Projekts. Matthias Ramahi ist Herausgeber. Auspicious Music ist ein neues redaktionelles Projekt und keine Fortsetzung des früheren Betreibers.',
} : {
  title: 'Auspicious Music — Plan music for ceremonies and events',
  description: 'Choose music for a wedding, memorial or event: select the moments, listen to three repertoire suggestions and prepare a running order for personal review.',
  h1: 'Music that fits your moment.', intro: 'Choose the occasion and the moments that need music. The planner returns three pieces and a running order for personal review.',
  primary: 'Create a music plan', occasionLabel: 'What are you planning music for?',
  occasions: [['Wedding', 'hochzeit'], ['Independent ceremony', 'hochzeit'], ['Church ceremony', 'hochzeit'], ['Drinks reception', 'sektempfang'], ['Funeral / memorial', 'trauerfeier'], ['Concert & event', 'firmenevent']],
  howLabel: 'Three short decisions',
  steps: [['Choose the occasion', 'Wedding, memorial, reception or another event.'], ['Choose the moments', 'Keep only the points where music has a role.'], ['Listen to three pieces', 'Each title is assigned to the running order.']],
  exampleTitle: 'What a selection looks like', exampleNote: 'Wedding example · the planner creates your own selection.', listen: 'Search and listen on YouTube', moment: 'In the running order', why: 'Why it is here',
  examples: [
    ['A Thousand Years', 'Warm and personal, with enough time for the entrance.', 'Entrance'],
    ['Canon in D', 'Clear and formal; the version can be fitted to the length of the moment.', 'Rings, vows or signing'],
    ['Perfect', 'Modern and light, marking the change from ceremony to celebration.', 'Exit'],
  ],
  outcomeLabel: 'What the planner does', outcomeTitle: 'A small selection you can actually discuss.', outcomeIntro: 'You do not need a fixed date or a finished event schedule to begin.',
  outcomes: [['Three pieces', 'Three suggestions for the chosen moments, not the whole repertoire.'], ['One running order', 'Each piece is placed where it could work.'], ['Open questions', 'Anything that still needs review with the venue and musician remains visible.']],
  guidesLabel: 'Start with the occasion', guidesTitle: 'Each running order needs a different selection.', guidesIntro: 'The German occasion pages have their own quick selectors. The English planner uses the same occasion-specific repertoire without duplicating unfinished translations.',
  guides: [['Wedding music', 'Plan the entrance, signing, reflection and exit.', '/en/tools/event-music-planner/?occasion=hochzeit'], ['Drinks reception', 'Find light music for arrivals, congratulations and conversation.', '/en/tools/event-music-planner/?occasion=sektempfang'], ['Funeral or memorial', 'Place a small number of personal pieces around the farewell.', '/en/tools/event-music-planner/?occasion=trauerfeier'], ['Dinner music', 'Fit music around arrival, courses, speeches and the closing.', '/en/tools/event-music-planner/?occasion=dinner'], ['Corporate event music', 'Separate reception, background and featured moments.', '/en/tools/event-music-planner/?occasion=firmenevent'], ['Birthday music', 'Prepare a surprise, musical gift or reception.', '/en/tools/event-music-planner/?occasion=geburtstag']],
  handoffTitle: 'The plan prepares the enquiry. It is not a booking.',
  handoffText: 'Kim-Marie Borger personally reviews the date, titles, version and line-up. The planner provides a direct path to her contact page.',
  handoffAction: 'Start a music plan',
  disclosure: 'Kim-Marie Borger is the current musical expert for this project. Matthias Ramahi is the publisher. Auspicious Music is a new editorial project, not a continuation of the former operator.',
};
---

<BaseLayout title={copy.title} description={copy.description} canonicalPath={de ? '/' : '/en/'} lang={lang} headerOverDark={true} loadStringField={true} alternatePath={de ? '/en/' : '/'}>
  <Fragment slot="head">
    <style is:global>
      @layer components {
        .focus-home { background: #fff; color: #17191f; }
        .focus-hero { position: relative; min-height: clamp(31rem, 54svh, 35rem); margin-top: calc(-1 * var(--header-h)); padding-top: var(--header-h); overflow: hidden; background: radial-gradient(ellipse at 50% 18%, #181a1d 0%, #0d0f11 58%, #090a0c 100%); color: #f7f4ee; }
        .focus-hero::before { content: ''; position: absolute; inset: 0; background: var(--grain); background-size: 160px 160px; opacity: .035; pointer-events: none; }
        .focus-hero__string { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; --string-line: #d7b66e; --string-node: #a81f42; opacity: .72; }
        .focus-hero__inner { position: relative; z-index: 2; display: grid; grid-template-rows: 1fr auto; min-height: clamp(31rem, 54svh, 35rem); box-sizing: border-box; padding-block: clamp(4.5rem, 7vh, 5.5rem) .8rem; pointer-events: none; }
        .focus-hero__copy { width: min(48rem, 100%); margin: auto; text-align: center; pointer-events: auto; }
        .focus-hero h1 { max-width: 15ch; margin-inline: auto; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(3rem, 1.8rem + 3vw, 4.7rem); font-weight: 500; line-height: 1.04; letter-spacing: 0; text-wrap: balance; }
        .focus-hero__flourish { display: flex; justify-content: center; align-items: center; gap: .85rem; margin: 1rem auto; color: #d7b66e; }
        .focus-hero__flourish::before, .focus-hero__flourish::after { content: ''; width: clamp(3rem, 8vw, 7rem); height: 1px; background: currentColor; opacity: .75; }
        .focus-hero__pluck { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid currentColor; border-radius: 50%; color: inherit; }
        .focus-hero__pluck svg { width: 1.05rem; height: 1.05rem; }
        .focus-hero__intro { max-width: 48rem; margin-inline: auto; color: #e1e0dc; font-size: clamp(1rem, .94rem + .22vw, 1.18rem); line-height: 1.55; }
        .focus-hero__actions { margin-top: 1.5rem; }
        .focus-hero__actions .btn { min-width: min(22rem, 100%); min-height: 58px; justify-content: center; border-radius: 2px; font-size: 1rem; }
        .occasion-start { width: 100%; max-width: 76rem; margin: clamp(2.4rem, 6vh, 4rem) auto 0; pointer-events: auto; }
        .occasion-start > p { color: #d7b66e; font: 700 .77rem/1.2 var(--font-sans); text-transform: uppercase; letter-spacing: .12em; text-align: center; }
        .occasion-start ul { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin-top: .65rem; }
        .occasion-start a { position: relative; display: grid; justify-items: center; gap: .5rem; min-height: 66px; padding: .65rem .35rem .8rem; color: #e8e6e1; font-size: .86rem; text-align: center; text-decoration: none; }
        .occasion-start a::before { content: attr(data-number); color: #d7b66e; font: 500 1rem/1 Georgia, serif; }
        .occasion-start a::after { content: ''; position: absolute; inset: auto .7rem 0; height: 2px; background: #a81f42; transform: scaleX(0); transition: transform 180ms ease; }
        .occasion-start a:hover::after, .occasion-start a:focus-visible::after { transform: scaleX(1); }
        .focus-how { padding-block: 1.25rem; background: #fff; border-bottom: 1px solid #dadbdc; }
        .focus-how__label { color: #765a1f; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; text-align: center; }
        .focus-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 76rem; margin: 1.15rem auto 0; }
        .focus-step { position: relative; display: grid; grid-template-columns: 2.65rem 1fr; gap: .8rem; align-items: start; padding-inline: clamp(.7rem, 2.5vw, 2rem); }
        .focus-step + .focus-step { border-left: 1px solid #d6d7d8; }
        .focus-step__n { display: grid; place-items: center; width: 2.3rem; height: 2.3rem; border-radius: 50%; background: #1b1d20; color: #fff; font-weight: 700; }
        .focus-step h3 { font-size: .98rem; letter-spacing: 0; }
        .focus-step p { margin-top: .2rem; color: #5f646a; font-size: .83rem; line-height: 1.45; }
        .focus-example { padding-block: clamp(2.2rem, 5vw, 4.2rem); background: #fff; }
        .focus-example__head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #d5d6d7; }
        .focus-example h2 { color: #8f1d35; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 1.6rem + 1vw, 2.8rem); font-weight: 500; letter-spacing: 0; }
        .focus-example__head p { color: #646a70; font-size: .84rem; }
        .music-row { display: grid; grid-template-columns: 2.5rem 3rem minmax(12rem, .95fr) minmax(15rem, 1.2fr) minmax(10rem, .7fr); gap: 1rem; align-items: center; min-height: 76px; border-bottom: 1px solid #dedfe0; }
        .music-row__number { color: #8f1d35; font-weight: 700; font-variant-numeric: tabular-nums; }
        .music-row__play { display: grid; place-items: center; width: 2.35rem; height: 2.35rem; border: 1px solid #33373b; border-radius: 50%; color: #17191f; text-decoration: none; }
        .music-row__play:hover { background: #17191f; color: #fff; }
        .music-row__play svg { width: .9rem; height: .9rem; margin-left: .12rem; }
        .music-row__title { font: 500 clamp(1.25rem, 1rem + .55vw, 1.75rem)/1.2 Georgia, 'Times New Roman', serif; }
        .music-row__detail small { display: block; margin-bottom: .25rem; color: #765a1f; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .09em; }
        .music-row__detail span { color: #3f4449; font-size: .84rem; line-height: 1.4; }
        .focus-outcomes { padding-block: clamp(3.5rem, 7vw, 5.5rem); background: #f4f5f6; border-block: 1px solid #d9dce0; }
        .focus-section-head { display: grid; gap: .75rem 4rem; }
        @media (min-width: 820px) { .focus-section-head { grid-template-columns: minmax(18rem, .8fr) minmax(0, 1.2fr); align-items: end; } }
        .focus-section-head h2 { font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 1.55rem + 1.3vw, 3rem); font-weight: 500; letter-spacing: 0; }
        .focus-section-head > p { max-width: 58ch; color: #5d646b; line-height: 1.65; }
        .focus-outcome-list { display: grid; margin-top: 2rem; border-top: 1px solid #bcc1c6; }
        @media (min-width: 760px) { .focus-outcome-list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
        .focus-outcome-list li { padding: 1.4rem clamp(0rem, 2vw, 1.5rem) 1.2rem; border-bottom: 1px solid #d5d9dc; }
        @media (min-width: 760px) { .focus-outcome-list li + li { border-left: 1px solid #d5d9dc; } }
        .focus-outcome-list span { color: #8f1d35; font: 500 .8rem/1.2 var(--font-sans); }
        .focus-outcome-list h3 { margin-top: .75rem; font-size: 1.08rem; letter-spacing: 0; }
        .focus-outcome-list p { margin-top: .45rem; color: #5d646b; font-size: .91rem; line-height: 1.6; }
        .focus-band { padding-block: clamp(3.5rem, 7vw, 6rem); }
        .focus-guides { background: #fff; }
        .focus-guide-list { display: grid; margin-top: 2rem; border-top: 1px solid #c5c9cd; }
        @media (min-width: 760px) { .focus-guide-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        .focus-guide-list li { border-bottom: 1px solid #d9dce0; }
        @media (min-width: 760px) { .focus-guide-list li:nth-child(odd) { padding-right: 2rem; border-right: 1px solid #d9dce0; } .focus-guide-list li:nth-child(even) { padding-left: 2rem; } }
        .focus-guide-list a { display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto; gap: .7rem 1rem; align-items: start; padding-block: 1.25rem; text-decoration: none; }
        .focus-guide-list .guide-number { color: #8f1d35; font-weight: 700; }
        .focus-guide-list h3 { font-size: 1.02rem; letter-spacing: 0; }
        .focus-guide-list p { grid-column: 2; color: #60676e; font-size: .9rem; line-height: 1.55; }
        .focus-guide-list .guide-arrow { color: #8f1d35; }
        .focus-handoff { background: #17191d; color: #f2efe8; }
        .focus-handoff__inner { display: grid; gap: 1rem 3rem; align-items: center; }
        @media (min-width: 820px) { .focus-handoff__inner { grid-template-columns: minmax(18rem, .8fr) minmax(0, 1.2fr) auto; } }
        .focus-handoff h2 { color: inherit; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.7rem, 1.35rem + .9vw, 2.4rem); font-weight: 500; letter-spacing: 0; }
        .focus-handoff p { color: #c5c8cc; line-height: 1.65; }
        .focus-handoff .btn { min-width: 12rem; justify-content: center; }
        .focus-disclosure { background: #0d0f11; color: #c4c7cd; padding-block: 1.6rem; }
        .focus-disclosure p { max-width: 78rem; font-size: .82rem; line-height: 1.55; }
        @media (max-width: 800px) {
          .occasion-start ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
          .focus-steps { grid-template-columns: 1fr; gap: 1rem; }
          .focus-step + .focus-step { border-left: 0; }
          .music-row { grid-template-columns: 2rem 2.6rem 1fr; gap: .7rem; padding-block: .85rem; }
          .music-row__detail { grid-column: 3; }
          .focus-example__head { display: block; }
          .focus-example__head p { margin-top: .45rem; }
        }
        @media (max-width: 520px) {
          .focus-hero { min-height: 43rem; }
          .focus-hero__inner { min-height: 43rem; padding-top: 5.5rem; }
          .focus-hero h1 { font-size: clamp(2.75rem, 13vw, 4rem); }
          .occasion-start { margin-top: 2.3rem; }
          .occasion-start a { min-height: 58px; font-size: .76rem; }
          .occasion-start a::before { font-size: .8rem; }
          .focus-how { padding-block: 1.6rem; }
          .music-row__detail span { font-size: .79rem; }
          .music-row__play { width: 2.75rem; height: 2.75rem; }
        }
      }
    </style>
  </Fragment>

  <main id="content" class="focus-home">
    <section class="focus-hero hero" data-stage-scene aria-labelledby="focus-home-title">
      <canvas class="focus-hero__string" data-string aria-hidden="true"></canvas>
      <div class="shell focus-hero__inner">
        <div class="focus-hero__copy">
          <h1 id="focus-home-title">{copy.h1}</h1>
          <div class="focus-hero__flourish"><button class="focus-hero__pluck" type="button" data-string-pluck aria-label={de ? 'Saiten anspielen' : 'Play the strings'} title={de ? 'Saiten anspielen' : 'Play the strings'}><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M2 10c3-6 5-6 8 0s5 6 8 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button></div>
          <p class="focus-hero__intro">{copy.intro}</p>
          <div class="focus-hero__actions"><a class="btn btn--primary" href={planner}>{copy.primary}<span aria-hidden="true">→</span></a></div>
        </div>
        <nav class="occasion-start" aria-label={copy.occasionLabel}><p>{copy.occasionLabel}</p><ul>{copy.occasions.map(([label, slug], index) => <li><a data-number={String(index + 1).padStart(2, '0')} href={de ? `/eventmusik/${slug}/` : `${planner}?occasion=${slug}`}>{label}</a></li>)}</ul></nav>
      </div>
    </section>

    <section class="focus-how" aria-labelledby="focus-how-title"><div class="shell"><h2 class="focus-how__label" id="focus-how-title">{copy.howLabel}</h2><ol class="focus-steps">{copy.steps.map(([title, text], index) => <li class="focus-step"><span class="focus-step__n">{index + 1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div></section>

    <section class="focus-example" aria-labelledby="focus-example-title"><div class="shell"><header class="focus-example__head"><h2 id="focus-example-title">{copy.exampleTitle}</h2><p>{copy.exampleNote}</p></header><ol>{copy.examples.map(([title, reason, moment], index) => <li class="music-row"><span class="music-row__number">{String(index + 1).padStart(2, '0')}</span><a class="music-row__play" href={youtubeSearchUrl(title)} target="_blank" rel="noopener noreferrer external" aria-label={`${title}: ${copy.listen}`} title={copy.listen}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 5 8 5-8 5Z" fill="currentColor"/></svg></a><span class="music-row__title">{title}</span><span class="music-row__detail"><small>{copy.why}</small><span>{reason}</span></span><span class="music-row__detail"><small>{copy.moment}</small><span>{moment}</span></span></li>)}</ol></div></section>

    <section class="focus-outcomes" aria-labelledby="focus-outcomes-title"><div class="shell"><header class="focus-section-head"><div><p class="kicker">{copy.outcomeLabel}</p><h2 id="focus-outcomes-title">{copy.outcomeTitle}</h2></div><p>{copy.outcomeIntro}</p></header><ol class="focus-outcome-list">{copy.outcomes.map(([title, text], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></div></section>

    <section class="focus-band focus-guides" aria-labelledby="focus-guides-title"><div class="shell"><header class="focus-section-head"><div><p class="kicker">{copy.guidesLabel}</p><h2 id="focus-guides-title">{copy.guidesTitle}</h2></div><p>{copy.guidesIntro}</p></header><ol class="focus-guide-list">{copy.guides.map(([title, text, href], index) => <li><a href={href}><span class="guide-number">{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{text}</p></div><span class="guide-arrow" aria-hidden="true">→</span></a></li>)}</ol></div></section>
    <section class="focus-band focus-handoff" aria-labelledby="focus-handoff-title"><div class="shell focus-handoff__inner"><h2 id="focus-handoff-title">{copy.handoffTitle}</h2><p>{copy.handoffText}</p><a class="btn btn--primary" href={planner}>{copy.handoffAction}</a></div></section>
    <aside class="focus-disclosure"><div class="shell"><p>{copy.disclosure}</p></div></aside>
  </main>
</BaseLayout>
