---
import { siteStrategy } from '../data/site-strategy';

interface Props { currentPath: string; overDark?: boolean; }
const { currentPath, overDark = false } = Astro.props;
interface NavChild { href: string; label: string; note?: string; }
interface NavItem { href: string; label: string; children?: readonly NavChild[]; }
const navigation: readonly NavItem[] = siteStrategy.navigation;
const isCurrent = (href: string) => currentPath.startsWith(href);
---
<a class="skip" href="#content">Zum Inhalt springen</a>
<header class="site-header" data-header {...(overDark ? { 'data-over-dark': '' } : {})}>
  <div class="shell site-header__inner">
    <a class="brand" href="/" aria-label="Auspicious Music Viola & Strings Lab — Startseite"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 12C5.7 4 8.3 4 12 12C15.7 20 18.3 20 22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M2 12C5.7 16 8.3 16 12 12C15.7 8 18.3 8 22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".42"/></svg><span>Auspicious Music<small class="brand__sub">Viola &amp; Strings Lab</small></span></a>
    <nav class="nav" aria-label="Hauptnavigation">
      <ul>
        {navigation.map(({ href, label, children }) => (
          <li class={children ? 'nav-group' : undefined}>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}{children && <svg class="nav-caret" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1.25 5 4.75 9 1.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>}</a>
            {children && <div class="nav-drop"><ul>{children.map((child) => <li><a href={child.href}><span class="nav-drop__label">{child.label}</span>{child.note && <span class="nav-drop__note">{child.note}</span>}</a></li>)}</ul></div>}
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-tools"><a class="header-cta btn btn--primary" href="/tools/eventmusik-planer/">Event planen</a><a class="icon-btn" href="/search/" aria-label="Suche"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="5.75" stroke="currentColor" stroke-width="1.7"/><path d="M13.2 13.2 17 17" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></a><button class="icon-btn menu-btn" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="menu" data-sheet-open><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 7h14M3 13h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button></div>
  </div>
</header>
<div class="sheet" id="menu" data-sheet data-open="false" role="dialog" aria-modal="true" aria-label="Menü" aria-hidden="true">
  <div class="shell sheet__head"><span class="brand"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 12C5.7 4 8.3 4 12 12C15.7 20 18.3 20 22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M2 12C5.7 16 8.3 16 12 12C15.7 8 18.3 8 22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".42"/></svg><span>Auspicious Music<small class="brand__sub">Viola &amp; Strings Lab</small></span></span><button class="icon-btn" type="button" aria-label="Menü schließen" data-sheet-close><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button></div>
  <nav class="shell sheet__nav" aria-label="Menü">
    <ul>
      <li><a class="sheet-link" href="/tools/eventmusik-planer/" aria-current={isCurrent('/tools/eventmusik-planer/') ? 'page' : undefined}>Eventmusik-Plan erstellen</a></li>
      {navigation.map(({ href, label, children }) => <li>{children ? <details class="sheet-group"><summary><span>{label}</span><svg class="nav-caret" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1.25 5 4.75 9 1.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></summary><ul><li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label} — Übersicht</a></li>{children.filter((child) => child.href !== href).map((child) => <li><a href={child.href}>{child.label}</a></li>)}</ul></details> : <a class="sheet-link" href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>}</li>)}
    </ul>
  </nav>
  <div class="shell sheet__foot"><a href="/about/history-and-relaunch/" style="text-decoration:none">Neue unabhängige Fachseite · Geschichte und Eigentümerschaft</a></div>
</div>
