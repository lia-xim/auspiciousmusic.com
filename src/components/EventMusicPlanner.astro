---
import BaseLayout from '../layouts/BaseLayout.astro';
import { occasionProfiles } from '../data/repertoire';
import { plannerLocations } from '../data/planner-locations';

interface Props { lang: 'de' | 'en'; }
const { lang } = Astro.props;
const de = lang === 'de';
const canonicalPath = de ? '/tools/eventmusik-planer/' : '/en/tools/event-music-planner/';
const alternatePath = de ? '/en/tools/event-music-planner/' : '/tools/eventmusik-planer/';
const otherProfile = {
  slug: 'other', labelDe: 'Anderer Anlass', labelEn: 'Another occasion',
  moments: [
    { de: 'Ankommen', en: 'Arrival', guidanceDe: 'Klären, ob Musik den Raum öffnet oder erst später beginnt.', guidanceEn: 'Clarify whether music opens the room or starts later.' },
    { de: 'Musikalischer Schwerpunkt', en: 'Featured musical moment', guidanceDe: 'Startsignal, gewünschte Aufmerksamkeit und ein flexibles Ende festlegen.', guidanceEn: 'Set the cue, desired level of attention and a flexible ending.' },
    { de: 'Übergang', en: 'Transition', guidanceDe: 'Musik mit Moderation, Service oder Ortswechsel verbinden.', guidanceEn: 'Connect the music with moderation, service or a location change.' },
    { de: 'Abschluss', en: 'Closing', guidanceDe: 'Ein klares Ende und den nächsten Programmpunkt abstimmen.', guidanceEn: 'Agree a clear ending and the next programme item.' },
  ],
  questionsDe: ['Wer gibt vor Ort das Startsignal?', 'Welche Funktion soll die Musik erfüllen?', 'Welche räumlichen oder zeitlichen Grenzen sind bekannt?'],
  questionsEn: ['Who gives the cue on site?', 'What function should the music fulfil?', 'Which spatial or timing constraints are already known?'],
  pieces: [],
};
const eventProfiles = occasionProfiles.filter((profile) => profile.slug !== 'unterricht');
const plannerData = [...eventProfiles.map(({ slug, labelDe, labelEn, moments, questionsDe, questionsEn, pieces }) => ({ slug, labelDe, labelEn, moments, questionsDe, questionsEn, pieces })), otherProfile];
const copy = de ? {
  title: 'Musikempfehlungen für dein Event', description: 'Erhalte in drei kurzen Schritten drei begründete Repertoire-Ideen mit passenden Spielmomenten und einem kompakten Ablauf.',
  intro: 'Anlass und Wirkung auswählen. Der Planer macht daraus echte Vorschläge statt nur deine Eingaben zu wiederholen.', privacy: 'Bleibt in diesem Browser. Keine Anmeldung, Speicherung oder automatische Anfrage.',
  steps: ['Anlass', 'Rahmen', 'Wirkung'], stepLabel: 'Schritt', chooseOccasion: 'Was planst du?', chooseOccasionNote: 'Wähle den Rahmen, der deinem Termin am nächsten kommt.', other: 'Anderer Anlass', otherLabel: 'Anlass kurz benennen',
  frame: 'Wann und wo findet es statt?', frameNote: 'Ort und Datum reichen zunächst. Alles Weitere kann später geklärt werden.', date: 'Datum', exact: 'Festes Datum', period: 'Zeitraum', openDate: 'Noch offen', from: 'Von', until: 'Bis',
  location: 'Ort oder Region', locationPlaceholder: 'Ort eingeben oder unten auswählen', supported: 'Aktiv veröffentlichte Orte und Regionen', supportedNote: '49 belegte Orte und Regionen. Ein anderer Ort bleibt möglich und wird individuell geprüft.', otherLocation: 'Anderen Ort übernehmen',
  setting: 'Ortssituation', role: 'Rolle der Musik', sound: 'Klang / Besetzung', music: 'Welche Momente soll die Musik tragen?', musicNote: 'Die typischen Momente für diesen Anlass sind vorausgewählt. Nimm nur die auf, die wirklich stattfinden.', wishes: 'Wunschstück oder kurze Notiz', wishesPlaceholder: 'Optional: Titel, Stil oder persönlicher Bezug', refine: 'Gewünschte Wirkung',
  back: 'Zurück', nextFrame: 'Weiter: Rahmen', nextMusic: 'Weiter: Wirkung', create: 'Empfehlungen anzeigen', edit: 'Auswahl ändern', restart: 'Neu beginnen',
  liveTitle: 'Dein Plan', empty: 'Noch keine Auswahl', waitingMoments: 'Noch keine Programmpunkte', waitingPieces: 'Wird aus deiner Auswahl berechnet',
  resultTitle: 'Drei Vorschläge für deinen Ablauf', resultLead: 'Zuerst die Musik: drei Titel, ihr passender Moment und der Grund für die Empfehlung.', overview: 'Rahmen', flow: 'Ablauf', shortlist: 'Unsere Vorschläge', questions: 'Noch zu klären', details: 'Ablauf und offene Punkte ansehen', why: 'Warum passt es?', listen: 'Auf YouTube suchen und anhören',
  copyAction: 'Plan kopieren', copied: 'Plan kopiert', download: 'TXT laden', email: 'E-Mail mit Plan öffnen', contact: 'Plan kopieren & Kontakt öffnen', forMoment: 'Vorgeschlagen für', boundary: 'Die Vorschläge beruhen auf Anlass, Moment und gewünschter Wirkung. Sie bestätigen weder Termin, Besetzung, konkrete Fassung, Notenlage, Arrangement, Rechte, Preis noch Buchung.',
  requiredOccasion: 'Bitte wähle einen Anlass.', requiredOther: 'Bitte benenne den anderen Anlass kurz.', requiredLocation: 'Bitte gib einen Ort oder eine Region an.', requiredDate: 'Bitte wähle ein Datum oder markiere „Noch offen“.', requiredPeriod: 'Bitte wähle einen vollständigen, zeitlich korrekten Zeitraum.', requiredMoment: 'Bitte wähle mindestens einen Spielmoment.',
  supportedStatus: 'veröffentlichte Region', customStatus: 'individuell zu prüfen', noDate: 'Noch offen', noPieces: 'Noch keine Titel gewählt', noWishes: 'Keine Zusatznotiz', emailSubject: 'Eventmusik-Anfrage',
} : {
  title: 'Music suggestions for your event', description: 'Get three reasoned repertoire ideas with suitable musical moments and a compact running order in three short steps.',
  intro: 'Choose the occasion and desired character. The planner turns them into suggestions rather than repeating your entries.', privacy: 'Stays in this browser. No account, storage or automatic enquiry.',
  steps: ['Occasion', 'Setting', 'Character'], stepLabel: 'Step', chooseOccasion: 'What are you planning?', chooseOccasionNote: 'Choose the option closest to your event.', other: 'Another occasion', otherLabel: 'Name the occasion briefly',
  frame: 'When and where will it happen?', frameNote: 'Location and date are enough for now. Everything else can be clarified later.', date: 'Date', exact: 'Exact date', period: 'Date range', openDate: 'Not decided', from: 'From', until: 'Until',
  location: 'Place or region', locationPlaceholder: 'Type a place or choose below', supported: 'Published locations and regions', supportedNote: '49 evidenced locations and regions. Another place is still possible and will be checked individually.', otherLocation: 'Use another place',
  setting: 'Location setting', role: 'Role of the music', sound: 'Sound / line-up', music: 'Which moments should the music support?', musicNote: 'Typical moments are preselected. Keep only those that will actually happen.', wishes: 'Requested piece or short note', wishesPlaceholder: 'Optional: title, style or personal meaning', refine: 'Desired character',
  back: 'Back', nextFrame: 'Next: setting', nextMusic: 'Next: character', create: 'Show suggestions', edit: 'Change selection', restart: 'Start again',
  liveTitle: 'Your plan', empty: 'No selection yet', waitingMoments: 'No programme moments yet', waitingPieces: 'No pieces yet',
  resultTitle: 'Three suggestions for your running order', resultLead: 'Music first: three titles, their suitable moment and the reason for each recommendation.', overview: 'Setting', flow: 'Running order', shortlist: 'Our suggestions', questions: 'Still to clarify', details: 'View running order and open questions', why: 'Why it fits', listen: 'Search and listen on YouTube',
  copyAction: 'Copy plan', copied: 'Plan copied', download: 'Download TXT', email: 'Open email with plan', contact: 'Copy plan & open contact', forMoment: 'Suggested for', boundary: 'Suggestions are based on occasion, moment and desired character. They do not confirm date, line-up, exact version, notation, arrangement, rights, price or booking.',
  requiredOccasion: 'Choose an occasion.', requiredOther: 'Name the other occasion briefly.', requiredLocation: 'Enter a place or region.', requiredDate: 'Choose a date or mark it as not decided.', requiredPeriod: 'Choose a complete date range in chronological order.', requiredMoment: 'Choose at least one musical moment.',
  supportedStatus: 'published region', customStatus: 'to be checked individually', noDate: 'Not decided', noPieces: 'No titles selected', noWishes: 'No additional note', emailSubject: 'Event music enquiry',
};
const occasions = eventProfiles.map((profile) => ({ value: profile.slug, label: de ? profile.labelDe : profile.labelEn, note: de && profile.slug === 'geburtstag' ? 'Überraschung, Geschenk oder Empfang' : de ? profile.shortDe : profile.shortEn }));
const settings = de ? [
  ['indoor', 'Innenraum', 'Akustik und Wege vor Ort'], ['outdoor', 'Draußen', 'Nur mit Schutz und Plan B'], ['both', 'Innen und draußen', 'Ortswechsel einplanen'], ['open', 'Noch offen', 'Im Gespräch festlegen'],
] : [
  ['indoor', 'Indoor', 'Room and access on site'], ['outdoor', 'Outdoor', 'Only with cover and Plan B'], ['both', 'Indoor and outdoor', 'Allow for a location change'], ['open', 'Not decided', 'Clarify in conversation'],
];
const roles = de ? [['background', 'Begleitend', 'Raum für Gespräche'], ['featured', 'Im Mittelpunkt', 'Eigener Programmpunkt'], ['both', 'Beides', 'Begleitung plus Akzent']] : [['background', 'Background', 'Leave room for conversation'], ['featured', 'Featured', 'A programme item of its own'], ['both', 'Both', 'Background plus a highlight']];
const sounds = de ? [['solo', 'Solo-Viola'], ['accompanied', 'Viola mit Begleitung'], ['small', 'Kleine Besetzung, falls verfügbar'], ['recommend', 'Offen für Empfehlung']] : [['solo', 'Solo viola'], ['accompanied', 'Viola with accompaniment'], ['small', 'Small ensemble, if available'], ['recommend', 'Open to a recommendation']];
const characters = de ? [['open', 'Offen'], ['warm', 'Warm'], ['calm', 'Ruhig'], ['bright', 'Leicht'], ['formal', 'Feierlich'], ['modern', 'Modern']] : [['open', 'Open'], ['warm', 'Warm'], ['calm', 'Calm'], ['bright', 'Light'], ['formal', 'Formal'], ['modern', 'Modern']];
const schema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: copy.title, description: copy.description, url: `https://www.auspiciousmusic.com${canonicalPath}`, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', browserRequirements: 'JavaScript', inLanguage: lang, isAccessibleForFree: true };
---

<BaseLayout title={`${copy.title} — Auspicious Music`} description={copy.description} canonicalPath={canonicalPath} lang={lang} alternatePath={alternatePath}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <style is:global>
      @layer components {
        .sr-only { position: absolute !important; width: 1px !important; height: 1px !important; padding: 0 !important; margin: -1px !important; overflow: hidden !important; clip: rect(0, 0, 0, 0) !important; white-space: nowrap !important; border: 0 !important; }
        .planner-page { background: #f3f4f5; color: #17191f; padding-block: clamp(1.6rem, 4vw, 3rem) clamp(4rem, 8vw, 7rem); }
        .planner-intro { display: flex; justify-content: space-between; align-items: end; gap: 1rem 3rem; padding-block: clamp(1.2rem, 3vw, 2.2rem); }
        .planner-intro h1 { max-width: none; font-size: clamp(2rem, 1.5rem + 2vw, 3.25rem); letter-spacing: 0; }
        .planner-intro p { max-width: 44rem; margin-top: .55rem; color: #58616b; }
        .planner-privacy { max-width: 28rem; border-left: 2px solid #8f1d35; padding-left: 1rem; color: #58616b; font-size: .88rem; line-height: 1.55; }
        .planner-app { max-width: 68rem; margin-inline: auto; border: 1px solid #c8cdd2; border-radius: 6px; background: #fff; box-shadow: 0 16px 44px rgba(23, 25, 31, .08); overflow: hidden; }
        .planner-progress { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid #dfe3e6; }
        .planner-progress button { display: flex; align-items: center; gap: .65rem; min-height: 54px; padding: .7rem clamp(.7rem, 2vw, 1.2rem); border: 0; border-right: 1px solid #e3e6e8; background: #f8f9fa; color: #69727c; font: 600 .82rem/1.2 var(--font-sans); text-align: left; cursor: pointer; }
        .planner-progress button:last-child { border-right: 0; }
        .planner-progress button[aria-current="step"] { background: #fff; color: #17191f; box-shadow: inset 0 -3px #8f1d35; }
        .planner-progress button:disabled { cursor: default; }
        .planner-progress__number { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; flex: none; border: 1px solid #bfc6cc; border-radius: 50%; font-variant-numeric: tabular-nums; }
        .planner-progress button[aria-current="step"] .planner-progress__number, .planner-progress button[data-complete="true"] .planner-progress__number { border-color: #8f1d35; background: #8f1d35; color: #fff; }
        .planner-workbench { display: block; min-height: 30rem; }
        .planner-form { min-width: 0; max-width: 58rem; margin-inline: auto; padding: clamp(1.2rem, 3vw, 2.25rem); }
        .planner-workbench[hidden], .planner-step[hidden], .planner-result[hidden], [data-date-fields][hidden], [data-other-occasion][hidden] { display: none !important; }
        .planner-step__head { margin-bottom: 1.4rem; }
        .planner-step__head h2 { font-size: clamp(1.5rem, 1.25rem + .8vw, 2rem); }
        .planner-step__head p { max-width: 55ch; margin-top: .35rem; color: #68717b; }
        .planner-section { margin-top: 1.5rem; padding-top: 1.4rem; border-top: 1px solid #e2e5e8; }
        .planner-section:first-of-type { margin-top: 0; padding-top: 0; border-top: 0; }
        .planner-section legend, .planner-label { display: block; margin-bottom: .75rem; color: #292e35; font-size: .92rem; font-weight: 700; }
        .planner-section fieldset { min-width: 0; border: 0; padding: 0; }
        .option-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; }
        @media (min-width: 680px) { .option-grid--occasion { grid-template-columns: repeat(4, minmax(0, 1fr)); } .option-grid--three { grid-template-columns: repeat(3, minmax(0, 1fr)); } .option-grid--four { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
        .option { position: relative; display: grid; align-content: start; gap: .3rem; min-height: 74px; padding: .8rem .85rem; border: 1px solid #d6dbe0; border-radius: 4px; background: #fff; cursor: pointer; }
        .option:hover { border-color: #7b858e; }
        .option:has(input:checked) { border-color: #8f1d35; box-shadow: inset 0 0 0 1px #8f1d35; background: #fffafb; }
        .option input { position: absolute; width: 1px; height: 1px; opacity: 0; }
        .option strong { min-width: 0; font-size: .92rem; line-height: 1.25; overflow-wrap: anywhere; hyphens: auto; }
        .option small { min-width: 0; color: #68717b; font-size: .76rem; line-height: 1.35; overflow-wrap: anywhere; hyphens: auto; }
        .option:has(input:focus-visible) { outline: 3px solid color-mix(in srgb, #8f1d35 35%, transparent); outline-offset: 2px; }
        .compact-options .option { min-height: 48px; align-content: center; }
        .planner-input { width: 100%; min-height: 48px; border: 1px solid #bfc6cc; border-radius: 4px; background: #fff; color: #17191f; padding: .7rem .8rem; font: 500 1rem/1.4 var(--font-sans); }
        .planner-input:focus { border-color: #8f1d35; outline: 3px solid color-mix(in srgb, #8f1d35 20%, transparent); }
        .date-row { display: grid; gap: .7rem; }
        @media (min-width: 620px) { .date-row--two { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        .field-label { display: grid; gap: .4rem; color: #424951; font-size: .82rem; font-weight: 650; }
        .location-box { border: 1px solid #d6dbe0; border-radius: 4px; overflow: hidden; }
        .location-box .planner-input { border: 0; border-bottom: 1px solid #d6dbe0; border-radius: 0; }
        .location-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(8.25rem, 1fr)); gap: 1px; max-height: 9rem; overflow-y: auto; background: #e2e5e8; }
        .location-list button { min-height: 42px; border: 0; background: #fff; color: #30363d; padding: .55rem .7rem; text-align: left; font: 550 .82rem/1.25 var(--font-sans); cursor: pointer; }
        .location-list button:hover, .location-list button[aria-pressed="true"] { background: #eef5f3; color: #1e5c52; }
        .location-list button:focus-visible { position: relative; z-index: 1; outline: 3px solid #8f1d35; outline-offset: -3px; }
        .location-note { display: flex; justify-content: space-between; gap: .5rem 1rem; flex-wrap: wrap; margin-top: .5rem; color: #68717b; font-size: .78rem; line-height: 1.45; }
        .planner-error { min-height: 1.4rem; margin-top: 1rem; color: #9b2837; font-weight: 650; }
        .planner-nav { display: flex; justify-content: space-between; gap: .75rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #e2e5e8; }
        .planner-nav [hidden] { display: none; }
        .planner-summary { border-left: 1px solid #dfe3e6; background: #f8f9fa; padding: clamp(1.1rem, 2.5vw, 1.6rem); }
        .planner-summary h2 { font-size: 1.05rem; }
        .summary-status { margin-left: .35rem; color: #626b74; font-size: .78rem; font-weight: 500; }
        .summary-section { padding-block: 1rem; border-bottom: 1px solid #dfe3e6; }
        .summary-section:last-child { border-bottom: 0; }
        .summary-section h3 { margin-bottom: .55rem; font-size: .78rem; text-transform: uppercase; color: #626c75; }
        .summary-list { display: grid; gap: .45rem; color: #30363d; font-size: .86rem; line-height: 1.4; }
        .summary-list li { display: flex; justify-content: space-between; gap: 1rem; }
        .summary-list span:last-child { color: #68717b; text-align: right; }
        .check-grid { display: grid; gap: .45rem; }
        .check-option { display: flex; gap: .65rem; align-items: start; padding: .65rem .7rem; border: 1px solid #d9dde1; border-radius: 4px; cursor: pointer; }
        .check-option:has(input:checked) { border-color: #2c6d62; background: #f1f7f5; }
        .check-option input { width: 1rem; height: 1rem; margin-top: .15rem; accent-color: #2c6d62; }
        .check-option span { display: grid; gap: .15rem; font-size: .88rem; }
        .check-option small { color: #68717b; line-height: 1.35; }
        .optional-details { margin-top: 1rem; border-top: 1px solid #e2e5e8; padding-top: .9rem; }
        .optional-details summary { cursor: pointer; color: #30363d; font-weight: 700; }
        .optional-details > div { margin-top: .8rem; }
        .planner-result { padding: clamp(1.2rem, 3vw, 2.3rem); scroll-margin-top: calc(var(--header-h) + .75rem); }
        .result-head { display: flex; justify-content: space-between; gap: 1rem 2rem; align-items: end; padding-bottom: 1.2rem; border-bottom: 1px solid #dfe3e6; }
        .result-head h2 { color: #8f1d35; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.9rem, 1.45rem + 1vw, 2.55rem); font-weight: 500; letter-spacing: 0; }
        .result-head p { margin-top: .35rem; color: #68717b; }
        .result-overview { display: flex; flex-wrap: wrap; gap: .45rem 1.4rem; margin-top: 1rem; color: #454b52; font-size: .82rem; }
        .result-overview > div { display: flex; gap: .35rem; }
        .result-overview dt { color: #747b83; }
        .result-overview dt::after { content: ':'; }
        .result-overview dd { font-weight: 700; }
        .result-grid { margin-top: 1.2rem; border-top: 1px solid #d4d7da; }
        .result-section { padding-block: 1.2rem; }
        .result-section h3 { margin-bottom: .9rem; font-size: 1rem; }
        .timeline { display: grid; gap: 0; }
        .timeline li { position: relative; padding: 0 0 1rem 1.2rem; border-left: 1px solid #8f1d35; }
        .timeline li::before { content: ''; position: absolute; left: -4px; top: .3rem; width: 7px; height: 7px; border-radius: 50%; background: #8f1d35; }
        .timeline li:last-child { padding-bottom: 0; }
        .timeline strong { display: block; font-size: .9rem; }
        .timeline small { display: block; margin-top: .15rem; color: #68717b; line-height: 1.4; }
        .repertoire-result, .questions-result { display: grid; }
        .repertoire-result li { display: grid; grid-template-columns: 2.3rem 2.8rem minmax(10rem, .9fr) minmax(14rem, 1.3fr) minmax(10rem, .75fr); gap: 1rem; align-items: center; min-height: 78px; padding-block: .75rem; border-bottom: 1px solid #dfe2e4; }
        .recommendation-number { color: #8f1d35; font-weight: 700; font-variant-numeric: tabular-nums; }
        .recommendation-play { display: grid; place-items: center; width: 2.35rem; height: 2.35rem; border: 1px solid #31353a; border-radius: 50%; color: #17191f; text-decoration: none; }
        .recommendation-play:hover { background: #17191f; color: #fff; }
        .recommendation-play svg { width: .9rem; height: .9rem; margin-left: .12rem; }
        .recommendation-title { font: 500 clamp(1.2rem, 1rem + .45vw, 1.6rem)/1.2 Georgia, 'Times New Roman', serif; }
        .recommendation-detail small { display: block; margin-bottom: .22rem; color: #765a1f; font-size: .68rem; font-weight: 700; line-height: 1.25; text-transform: uppercase; letter-spacing: .08em; }
        .recommendation-detail span { display: block; color: #444a50; font-size: .82rem; line-height: 1.4; }
        .result-details { border-bottom: 1px solid #d4d7da; }
        .result-details summary { display: flex; justify-content: space-between; align-items: center; min-height: 54px; color: #30363d; font-weight: 700; cursor: pointer; list-style: none; }
        .result-details summary::-webkit-details-marker { display: none; }
        .result-details summary::after { content: '+'; color: #8f1d35; font-size: 1.4rem; font-weight: 400; }
        .result-details[open] summary::after { content: '−'; }
        .result-support { display: grid; gap: 1.5rem 3rem; padding-bottom: 1.4rem; }
        @media (min-width: 760px) { .result-support { grid-template-columns: 1fr 1fr; } }
        .questions-result { gap: .65rem; }
        .questions-result li { padding: 0 0 .75rem 1rem; border-bottom: 1px solid #e2e5e8; }
        .questions-result li { padding-left: 1rem; border-left: 2px solid #2c6d62; }
        .result-boundary { margin-top: 1.2rem; border-left: 2px solid #8f1d35; padding-left: .9rem; color: #606972; font-size: .82rem; line-height: 1.55; }
        .result-actions { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.2rem; }
        .result-actions .btn:last-child { margin-left: auto; }
        @media (max-width: 999px) { .planner-summary { border-left: 0; border-top: 1px solid #dfe3e6; } }
        @media (max-width: 620px) {
          .planner-page { padding-top: .75rem; }
          .planner-intro { display: block; }
          .planner-privacy { margin-top: .9rem; }
          .planner-progress button { justify-content: center; min-height: 48px; }
          .planner-progress button span:last-child { display: none; }
          .planner-form { padding: 1rem; }
          .option { min-height: 66px; padding: .7rem; }
          .planner-nav { position: sticky; bottom: 0; z-index: 3; margin-inline: -1rem; margin-bottom: -1rem; padding: .75rem 1rem max(.75rem, env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); box-shadow: 0 -8px 24px rgba(23,25,31,.08); }
          .planner-nav .btn { flex: 1; }
          .result-head { display: block; }
          .result-head .btn { margin-top: 1rem; }
          .repertoire-result li { grid-template-columns: 2rem 2.6rem 1fr; gap: .7rem; }
          .recommendation-detail { grid-column: 3; }
          .result-actions .btn { flex: 1 1 calc(50% - .4rem); }
          .result-actions .btn:last-child { margin-left: 0; flex-basis: 100%; }
        }
      }
    </style>
  </Fragment>

  <main id="content" class="planner-page">
    <div class="shell">
      <header class="planner-intro">
        <div><h1>{copy.title}</h1><p>{copy.intro}</p></div>
        <p class="planner-privacy">{copy.privacy}</p>
      </header>

      <section class="planner-app" data-planner-app aria-label={copy.title}>
        <nav class="planner-progress" aria-label={`${copy.stepLabel} 1–3`}>
          {copy.steps.map((label, index) => <button type="button" data-step-button={index + 1} aria-current={index === 0 ? 'step' : undefined} disabled={index > 0}><span class="planner-progress__number">{index + 1}</span><span>{label}</span></button>)}
        </nav>

        <div class="planner-workbench" data-workbench>
          <form class="planner-form" data-planner novalidate>
            <section class="planner-step" data-step="1">
              <header class="planner-step__head"><h2>{copy.chooseOccasion}</h2><p>{copy.chooseOccasionNote}</p></header>
              <fieldset class="planner-section"><legend class="sr-only">{copy.chooseOccasion}</legend><div class="option-grid option-grid--occasion">
                {occasions.map((occasion) => <label class="option"><input type="radio" name="occasion" value={occasion.value} /><strong>{occasion.label}</strong><small>{occasion.note}</small></label>)}
                <label class="option"><input type="radio" name="occasion" value="other" /><strong>{copy.other}</strong><small>+</small></label>
              </div></fieldset>
              <label class="field-label planner-section" data-other-occasion hidden>{copy.otherLabel}<input class="planner-input" name="occasionOther" maxlength="80" /></label>
            </section>

            <section class="planner-step" data-step="2" hidden>
              <header class="planner-step__head"><h2>{copy.frame}</h2><p>{copy.frameNote}</p></header>
              <fieldset class="planner-section"><legend>{copy.date}</legend><div class="option-grid option-grid--three compact-options">
                <label class="option"><input type="radio" name="dateMode" value="exact" checked /><strong>{copy.exact}</strong></label>
                <label class="option"><input type="radio" name="dateMode" value="period" /><strong>{copy.period}</strong></label>
                <label class="option"><input type="radio" name="dateMode" value="open" /><strong>{copy.openDate}</strong></label>
              </div><div class="date-row" data-date-fields="exact"><label class="field-label">{copy.date}<input class="planner-input" type="date" name="dateExact" /></label></div><div class="date-row date-row--two" data-date-fields="period" hidden><label class="field-label">{copy.from}<input class="planner-input" type="date" name="dateFrom" /></label><label class="field-label">{copy.until}<input class="planner-input" type="date" name="dateUntil" /></label></div></fieldset>

              <section class="planner-section"><label class="planner-label" for="planner-location">{copy.location}</label><div class="location-box"><input id="planner-location" class="planner-input" name="location" maxlength="120" autocomplete="off" type="search" aria-controls="planner-location-list" aria-describedby="planner-location-note" placeholder={copy.locationPlaceholder} /><div class="location-list" id="planner-location-list" role="group" aria-label={copy.supported}>{plannerLocations.map((location) => <button type="button" data-location={location.label} data-location-slug={location.slug}>{location.label}</button>)}</div></div><p class="location-note" id="planner-location-note"><span>{copy.supportedNote}</span><span data-location-state>{copy.customStatus}</span></p></section>

              <fieldset class="planner-section"><legend>{copy.setting}</legend><div class="option-grid option-grid--four">{settings.map(([value, label, note]) => <label class="option"><input type="radio" name="setting" value={value} /><strong>{label}</strong><small>{note}</small></label>)}</div></fieldset>
              <fieldset class="planner-section"><legend>{copy.role}</legend><div class="option-grid option-grid--three">{roles.map(([value, label, note], index) => <label class="option"><input type="radio" name="role" value={value} checked={index === 0} /><strong>{label}</strong><small>{note}</small></label>)}</div></fieldset>
              <fieldset class="planner-section"><legend>{copy.sound}</legend><div class="option-grid option-grid--four compact-options">{sounds.map(([value, label], index) => <label class="option"><input type="radio" name="sound" value={value} checked={index === 0} /><strong>{label}</strong></label>)}</div></fieldset>
            </section>

            <section class="planner-step" data-step="3" hidden>
              <header class="planner-step__head"><h2>{copy.music}</h2><p>{copy.musicNote}</p></header>
              <fieldset class="planner-section"><legend class="sr-only">{copy.music}</legend><div class="check-grid" data-moments></div></fieldset>
              <fieldset class="planner-section"><legend>{copy.refine}</legend><div class="option-grid option-grid--three compact-options">{characters.map(([value, label], index) => <label class="option"><input type="radio" name="character" value={value} checked={index === 0} /><strong>{label}</strong></label>)}</div></fieldset>
              <label class="field-label planner-section">{copy.wishes}<textarea class="planner-input" name="wishes" rows="3" maxlength="500" placeholder={copy.wishesPlaceholder}></textarea></label>
            </section>

            <p class="planner-error" data-planner-error aria-live="polite"></p>
            <div class="planner-nav"><button class="btn btn--quiet" type="button" data-back hidden>{copy.back}</button><button class="btn btn--primary" type="button" data-next>{copy.nextFrame}</button><button class="btn btn--primary" type="submit" data-create hidden>{copy.create}</button></div>
          </form>

        </div>

        <section class="planner-result" data-result hidden tabindex="-1">
          <header class="result-head"><div><h2>{copy.resultTitle}</h2><p>{copy.resultLead}</p></div><button class="btn btn--quiet" type="button" data-edit>{copy.edit}</button></header>
          <dl class="result-overview" data-result-overview></dl>
          <div class="result-grid"><section class="result-section"><h3 class="sr-only">{copy.shortlist}</h3><ol class="repertoire-result" data-result-pieces></ol></section><details class="result-details"><summary>{copy.details}</summary><div class="result-support"><section class="result-section"><h3>{copy.flow}</h3><ol class="timeline" data-result-flow></ol></section><section class="result-section"><h3>{copy.questions}</h3><ul class="questions-result" data-result-questions></ul></section></div></details></div>
          <p class="result-boundary">{copy.boundary}</p>
          <div class="result-actions"><button class="btn btn--quiet" type="button" data-copy>{copy.copyAction}</button><a class="btn btn--primary" href="https://kim-marie-borger.com/#kontakt" target="_blank" rel="noopener" data-contact>{copy.contact}</a></div>
        </section>
      </section>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline type="application/json" id={`planner-data-${lang}`} set:html={JSON.stringify({ profiles: plannerData, locations: plannerLocations, copy, lang })} />
    <script is:inline>
      (() => {
        const dataNode = document.querySelector('script[id^="planner-data-"]');
        const app = document.querySelector('[data-planner-app]');
        if (!dataNode || !(app instanceof HTMLElement)) return;
        const config = JSON.parse(dataNode.textContent || '{}');
        const { profiles, locations, copy, lang } = config;
        const bySlug = Object.fromEntries(profiles.map((profile) => [profile.slug, profile]));
        const form = app.querySelector('[data-planner]');
        const workbench = app.querySelector('[data-workbench]');
        const result = app.querySelector('[data-result]');
        const error = app.querySelector('[data-planner-error]');
        const momentsRoot = app.querySelector('[data-moments]');
        const locationInput = app.querySelector('#planner-location');
        const locationList = app.querySelector('#planner-location-list');
        const locationState = app.querySelector('[data-location-state]');
        const nextButton = app.querySelector('[data-next]');
        const backButton = app.querySelector('[data-back]');
        const createButton = app.querySelector('[data-create]');
        if (!(form instanceof HTMLFormElement) || !(workbench instanceof HTMLElement) || !(result instanceof HTMLElement) || !(error instanceof HTMLElement) || !(momentsRoot instanceof HTMLElement) || !(locationInput instanceof HTMLInputElement) || !(locationList instanceof HTMLElement) || !(locationState instanceof HTMLElement) || !(nextButton instanceof HTMLButtonElement) || !(backButton instanceof HTMLButtonElement) || !(createButton instanceof HTMLButtonElement)) return;
        let step = 1;
        let briefText = '';
        const normalize = (value) => String(value).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
        const checked = (name) => form.querySelector(`input[name="${name}"]:checked`);
        const checkedValue = (name) => checked(name)?.value || '';
        const checkedLabel = (name) => checked(name)?.closest('label')?.querySelector('strong')?.textContent?.trim() || '—';
        const profile = () => bySlug[checkedValue('occasion')];
        const occasionLabel = () => checkedValue('occasion') === 'other' ? String(new FormData(form).get('occasionOther') || '').trim() || copy.other : (lang === 'de' ? profile()?.labelDe : profile()?.labelEn) || '—';
        const formatDate = (value) => value ? new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(new Date(`${value}T12:00:00`)) : '';
        const dateLabel = () => { const data = new FormData(form); const mode = checkedValue('dateMode'); if (mode === 'open') return copy.noDate; if (mode === 'period') { const from = formatDate(data.get('dateFrom')); const until = formatDate(data.get('dateUntil')); return from && until ? `${from} – ${until}` : '—'; } return formatDate(data.get('dateExact')) || '—'; };
        const selectedMoments = () => [...form.querySelectorAll('input[name="moments"]:checked')].map((input) => profile()?.moments[Number(input.value)]).filter(Boolean);
        const selectedMomentIndexes = () => [...form.querySelectorAll('input[name="moments"]:checked')].map((input) => Number(input.value));
        const recommendations = () => {
          const selected = profile();
          if (!selected?.pieces?.length) return [];
          const chosenMoments = selectedMomentIndexes();
          const character = checkedValue('character');
          const ranked = selected.pieces.map((piece, index) => {
            const matchingMoments = (piece.moments || []).filter((moment) => chosenMoments.includes(moment));
            const characterFit = character !== 'open' && (piece.characters || []).includes(character);
            return { piece, index, matchingMoments, score: matchingMoments.length * 4 + (characterFit ? 5 : 0) + (selected.pieces.length - index) / 100 };
          }).sort((a, b) => b.score - a.score);
          const usedMoments = new Set();
          return ranked.slice(0, 3).map((item, index) => {
            const momentIndex = item.matchingMoments.find((value) => !usedMoments.has(value)) ?? item.matchingMoments[0] ?? chosenMoments[index % Math.max(chosenMoments.length, 1)] ?? 0;
            usedMoments.add(momentIndex);
            return { ...item, momentIndex };
          });
        };
        const minDate = (() => { const now = new Date(); return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`; })();
        form.querySelectorAll('input[type="date"]').forEach((input) => input.min = minDate);

        function renderProfileChoices() {
          const selected = profile();
          momentsRoot.innerHTML = selected ? selected.moments.map((moment, index) => `<label class="check-option"><input type="checkbox" name="moments" value="${index}" checked><span><strong>${escapeHtml(lang === 'de' ? moment.de : moment.en)}</strong><small>${escapeHtml(lang === 'de' ? moment.guidanceDe : moment.guidanceEn)}</small></span></label>`).join('') : '';
          updateSummary();
        }

        function renderLocations() {
          const query = normalize(locationInput.value.trim());
          const filtered = query ? locations.filter((location) => normalize(location.label).includes(query)) : locations;
          locationList.querySelectorAll('[data-location]').forEach((button) => { const show = filtered.some((location) => location.label === button.dataset.location); button.hidden = !show; button.setAttribute('aria-pressed', String(normalize(button.dataset.location) === query)); });
          const exact = locations.some((location) => normalize(location.label) === query);
          locationState.textContent = exact ? copy.supportedStatus : copy.customStatus;
        }

        function updateDateFields() {
          const mode = checkedValue('dateMode');
          app.querySelectorAll('[data-date-fields]').forEach((node) => node.hidden = node.getAttribute('data-date-fields') !== mode);
          updateSummary();
        }

        function updateSummary() {
          // The former live sidebar repeated form values and made the tool feel denser.
        }

        function setStep(next) {
          step = Math.max(1, Math.min(3, next));
          app.querySelectorAll('[data-step]').forEach((node) => node.hidden = Number(node.getAttribute('data-step')) !== step);
          app.querySelectorAll('[data-step-button]').forEach((button) => { const value = Number(button.getAttribute('data-step-button')); button.disabled = value > step; button.toggleAttribute('aria-current', value === step); if (value === step) button.setAttribute('aria-current', 'step'); button.dataset.complete = String(value < step); });
          backButton.hidden = step === 1;
          nextButton.hidden = step === 3;
          createButton.hidden = step !== 3;
          nextButton.textContent = step === 1 ? copy.nextFrame : copy.nextMusic;
          error.textContent = '';
          updateSummary();
          app.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
        }

        function validateStep(value) {
          const data = new FormData(form);
          if (value === 1) { if (!checkedValue('occasion')) return copy.requiredOccasion; if (checkedValue('occasion') === 'other' && !String(data.get('occasionOther') || '').trim()) return copy.requiredOther; }
          if (value === 2) { if (!locationInput.value.trim()) return copy.requiredLocation; const mode = checkedValue('dateMode'); if (mode === 'exact' && !data.get('dateExact')) return copy.requiredDate; if (mode === 'period') { const from = String(data.get('dateFrom') || ''); const until = String(data.get('dateUntil') || ''); if (!from || !until || until < from) return copy.requiredPeriod; } if (!checkedValue('setting')) return lang === 'de' ? 'Bitte wähle ein Setting.' : 'Choose a setting.'; }
          if (value === 3 && selectedMoments().length === 0) return copy.requiredMoment;
          return '';
        }

        function createBrief() {
          const data = new FormData(form); const selected = profile(); const moments = selectedMoments(); const pieces = recommendations();
          const overview = [[copy.steps[0], occasionLabel()], [copy.date, dateLabel()], [copy.location, locationInput.value.trim()], [copy.role, checkedLabel('role')]];
          app.querySelector('[data-result-overview]').innerHTML = overview.map(([label, value]) => `<div><dt>${escapeHtml(label)}</dt><dd>${escapeHtml(value)}</dd></div>`).join('');
          app.querySelector('[data-result-flow]').innerHTML = moments.map((moment) => `<li><strong>${escapeHtml(lang === 'de' ? moment.de : moment.en)}</strong><small>${escapeHtml(lang === 'de' ? moment.guidanceDe : moment.guidanceEn)}</small></li>`).join('');
          app.querySelector('[data-result-pieces]').innerHTML = pieces.map(({ piece, momentIndex }, index) => {
            const moment = selected?.moments[momentIndex];
            const momentLabel = moment ? (lang === 'de' ? moment.de : moment.en) : occasionLabel();
            const character = checkedValue('character');
            const characterReasons = lang === 'de' ? {
              warm: 'Warm und nahbar; passend für einen persönlichen Moment, ohne ihn zu überladen.',
              calm: 'Ruhig und getragen; lässt Worten, Wegen und Übergängen Raum.',
              bright: 'Leicht und offen; unterstützt Bewegung und einen positiven Übergang.',
              formal: 'Feierlich und klar; setzt diesen Programmpunkt bewusst in den Mittelpunkt.',
              modern: 'Zeitgenössisch und vertraut; setzt einen persönlichen modernen Akzent.',
              open: `Im gepflegten Repertoire dem Moment „${momentLabel}“ zugeordnet.`,
            } : {
              warm: 'Warm and approachable, fitting a personal moment without overwhelming it.',
              calm: 'Calm and sustained, leaving space for words, movement and transitions.',
              bright: 'Light and open, supporting movement and a positive transition.',
              formal: 'Formal and clearly shaped, giving this programme moment deliberate focus.',
              modern: 'Contemporary and familiar, adding a personal modern accent.',
              open: `Matched to “${momentLabel}” in the maintained repertoire.`,
            };
            const reason = characterReasons[character] || characterReasons.open;
            const clarification = lang === 'de' ? piece.clarificationDe : piece.clarificationEn;
            const youtubeUrl = `https://www.youtube.com/results?search_query=${encodeURIComponent(`${piece.title} Viola`)}`;
            const detail = clarification ? `${reason} ${clarification}` : reason;
            return `<li><span class="recommendation-number">${String(index + 1).padStart(2, '0')}</span><a class="recommendation-play" href="${escapeHtml(youtubeUrl)}" target="_blank" rel="noopener noreferrer external" aria-label="${escapeHtml(`${piece.title}: ${copy.listen}`)}" title="${escapeHtml(copy.listen)}"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 5 8 5-8 5Z" fill="currentColor"/></svg></a><strong class="recommendation-title">${escapeHtml(piece.title)}</strong><span class="recommendation-detail"><small>${escapeHtml(copy.why)}</small><span>${escapeHtml(detail)}</span></span><span class="recommendation-detail"><small>${escapeHtml(copy.forMoment)}</small><span>${escapeHtml(momentLabel)}</span></span></li>`;
          }).join('') || `<li>${escapeHtml(copy.noPieces)}</li>`;
          const questions = selected ? (lang === 'de' ? selected.questionsDe : selected.questionsEn) : [];
          app.querySelector('[data-result-questions]').innerHTML = questions.map((question) => `<li>${escapeHtml(question)}</li>`).join('');
          const wishes = String(data.get('wishes') || '').trim() || copy.noWishes;
          briefText = [lang === 'de' ? 'MUSIKPLAN ZUR ABSTIMMUNG' : 'MUSIC PLAN FOR REVIEW', '', ...overview.map(([label, value]) => `${label}: ${value}`), `${copy.setting}: ${checkedLabel('setting')}`, `${copy.sound}: ${checkedLabel('sound')}`, `${copy.refine}: ${checkedLabel('character')}`, '', copy.flow.toUpperCase(), ...moments.map((moment, index) => `${index + 1}. ${lang === 'de' ? moment.de : moment.en} — ${lang === 'de' ? moment.guidanceDe : moment.guidanceEn}`), '', copy.shortlist.toUpperCase(), ...(pieces.length ? pieces.map(({ piece, momentIndex }) => `- ${piece.title} — ${copy.forMoment}: ${lang === 'de' ? selected?.moments[momentIndex]?.de : selected?.moments[momentIndex]?.en}`) : [`- ${copy.noPieces}`]), '', `${copy.wishes}: ${wishes}`, '', copy.questions.toUpperCase(), ...questions.map((question) => `- ${question}`), '', copy.boundary].join('\n');
          workbench.hidden = true;
          result.hidden = false;
          result.focus({ preventScroll: true });
          requestAnimationFrame(() => result.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' }));
        }

        form.addEventListener('change', (event) => {
          if (event.target?.name === 'occasion') { app.querySelector('[data-other-occasion]').hidden = checkedValue('occasion') !== 'other'; renderProfileChoices(); }
          if (event.target?.name === 'dateMode') updateDateFields();
          updateSummary();
        });
        form.addEventListener('input', updateSummary);
        locationInput.addEventListener('input', renderLocations);
        locationList.addEventListener('click', (event) => { const button = event.target.closest('[data-location]'); if (!button) return; locationInput.value = button.dataset.location || ''; renderLocations(); updateSummary(); });
        nextButton.addEventListener('click', () => { const message = validateStep(step); if (message) { error.textContent = message; return; } setStep(step + 1); });
        backButton.addEventListener('click', () => setStep(step - 1));
        app.querySelectorAll('[data-step-button]').forEach((button) => button.addEventListener('click', () => { const target = Number(button.getAttribute('data-step-button')); if (target <= step) setStep(target); }));
        form.addEventListener('submit', (event) => { event.preventDefault(); const message = validateStep(3); if (message) { error.textContent = message; return; } createBrief(); });
        app.querySelector('[data-edit]').addEventListener('click', () => { result.hidden = true; workbench.hidden = false; setStep(3); });
        app.querySelector('[data-copy]').addEventListener('click', async (event) => { try { await navigator.clipboard.writeText(briefText); const button = event.currentTarget; button.textContent = copy.copied; setTimeout(() => { button.textContent = copy.copyAction; }, 1500); } catch { /* TXT remains available. */ } });
        app.querySelector('[data-contact]').addEventListener('click', async () => { try { await navigator.clipboard.writeText(briefText); } catch { /* The contact page still opens. */ } });
        const requested = new URLSearchParams(location.search).get(lang === 'de' ? 'anlass' : 'occasion') || new URLSearchParams(location.search).get('anlass');
        if (requested && bySlug[requested]) { const radio = form.querySelector(`input[name="occasion"][value="${CSS.escape(requested)}"]`); if (radio) { radio.checked = true; renderProfileChoices(); setStep(2); } }
        renderLocations(); updateDateFields(); updateSummary();
      })();
    </script>
  </Fragment>
</BaseLayout>
