{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/download", "destination": "/download/", "permanent": true },
    { "source": "/download.html", "destination": "/download/", "permanent": true },
    { "source": "/about.html", "destination": "/about/history-and-relaunch/", "permanent": true },
    { "source": "/connect.html", "destination": "/contact/", "permanent": true },
    { "source": "/2/post/2014/03/the-spy-guitar.html", "destination": "/legacy/the-spy-guitar/", "permanent": true },
    { "source": "/download/the-spy-guitar", "destination": "/legacy/the-spy-guitar/", "permanent": true },
    { "source": "/news/introducing-the-spy-guitar", "destination": "/legacy/the-spy-guitar/", "permanent": true },
    { "source": "/download/bang-my-twister-new-m4l-device-for-changing-banks-on-midi-fighter-twister", "destination": "/legacy/bang-my-twister/", "permanent": true },
    { "source": "/news/midi-fighter-twister-product-review", "destination": "/ableton/midi-fighter-twister-review/", "permanent": true },
    { "source": "/news/category/ableton", "destination": "/ableton/", "permanent": true },
    { "source": "/news/category/spy-guitar", "destination": "/legacy/the-spy-guitar/", "permanent": true }
  ],
  "routes": [
    {
      "src": "/download/hc/en-us/articles/41383541904281-Envato-Market-Terms/?",
      "status": 410
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
